{
  "name": "maintrack-cmms",
  "version": "1.0.0",
  "private": true,
  "description": "MainTrack CMMS - SaaS de Programacion de Mantenimiento Preventivo, Correctivo y Predictivo",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start -p ${PORT:-3000}",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "rm -f prisma/dev.db && prisma db push && tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "db:migrate": "prisma migrate deploy",
    "deploy": "bash scripts/deploy.sh",
    "catalogos:estandar": "tsx scripts/catalogos-estandar.ts",
    "super-admin": "tsx scripts/super-admin.ts",
    "almacen:configurar": "bash scripts/configurar-almacen.sh",
    "demo:sembrar": "tsx scripts/sembrar-demo.ts",
    "actualizar": "bash scripts/actualizar.sh",
    "respaldar": "bash scripts/respaldar.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@google-cloud/speech": "^8.1.0",
    "@google-cloud/storage": "^8.0.1",
    "@google-cloud/text-to-speech": "^7.1.0",
    "@prisma/client": "^6.3.1",
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "^2.4.3",
    "date-fns": "^4.1.0",
    "jose": "^5.9.6",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.474.0",
    "next": "15.1.6",
    "qrcode": "^1.5.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "recharts": "^3.0.0",
    "web-push": "^3.6.7",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@types/web-push": "^3.6.4",
    "prisma": "^6.3.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
