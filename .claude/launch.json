{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "maintrack-cmms",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "maintrack-utc",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "TZ=UTC",
        "npm",
        "run",
        "dev",
        "--",
        "-p",
        "3001"
      ],
      "port": 3001
    },
    {
      "name": "maintrack-con-voz",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "GOOGLE_CLOUD_PROJECT=maintrack-cmms-4821",
        "npm",
        "run",
        "dev",
        "--",
        "-p",
        "3002"
      ],
      "port": 3002
    },
    {
      "name": "maintrack-pantallas-ia",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "ANTHROPIC_API_KEY=sk-ant-solover",
        "npm",
        "run",
        "dev",
        "--",
        "-p",
        "3003"
      ],
      "port": 3003
    }
  ]
}