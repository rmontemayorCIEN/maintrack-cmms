{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "maintrack-cmms",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "maintrack-utc",
