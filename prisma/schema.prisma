// MainTrack CMMS - Esquema multi-tenant
// SQLite en desarrollo, PostgreSQL en produccion. Para cambiar de motor use
// scripts/use-postgres.sh (y scripts/revert-sqlite.sh para volver). No se usan
// enums ni arreglos nativos, de modo que el esquema es portable entre ambos.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- Tenancy ---

model Organization {
  id                    String    @id @default(cuid())
  name                  String
  slug                  String    @unique
  /// Giro en texto libre: "Manufactura metalmecanica", "Alimentos".
  industry              String?
  /// Tipo de instalacion, de lib/instalaciones.ts. Alimenta los ejemplos de
  /// captura y el contexto de todos los prompts de IA.
  tipoInstalacion       String?
  plan                  String    @default("PROFESSIONAL") // PROFESSIONAL | ENTERPRISE (lib/planes.ts)
  status                String    @default("ACTIVE") // ACTIVE | TRIAL | SUSPENDED | CANCELLED
  trialEndsAt           DateTime?
  seats                 Int       @default(10)
  timezone              String    @default("America/Mexico_City")
  currency              String    @default("MXN")
  locale                String    @default("es-MX")
  logoUrl               String?
  /// Paleta de acento de la empresa, de lib/apariencia.ts.
  colorAcento           String?
  settings              String    @default("{}")
  woSequence            Int       @default(0)
  wrSequence            Int       @default(0)
  poSequence            Int       @default(0)
  invSequence           Int       @default(0)
  tsSequence            Int       @default(0)
  rmSequence            Int       @default(0)
  rcSequence            Int       @default(0)
  reSequence            Int       @default(0)
  icSequence            Int       @default(0)
  /// Folio de los rondines (RD-000001).
  rdSequence            Int       @default(0)
  /// Si el proceso de compras corre DENTRO de MainTrack.
  ///
  /// Apagado por omision a proposito: la mayoria de las empresas ya compra en
  /// su ERP y no lo va a mover. Con el apagado, la requisicion de compra
  /// guarda el folio de la orden externa y salta directo a recepcion, sin
  /// perder trazabilidad de quien pidio ni de donde termino el material.
  /// Como le llama ESTA cuenta a un conjunto de equipos.
  ///
  /// Vacio significa "el que corresponde a mi tipo de instalacion": Linea en
  /// planta, Sistema en edificio, Servicio en club, Ruta en flotilla. Se llena
  /// solo cuando el cliente usa una palabra propia —hay plantas que dicen
  /// "celda" y hospitales que dicen "area critica"— y entonces gana sobre la
  /// del tipo. Nadie escribe la palabra en una pantalla: se lee de aqui.
  terminoConjunto       String?
  terminoConjuntoPlural String?

  comprasInternas   Boolean @default(false)
  /// Arriba de este monto la requisicion de compra necesita autorizacion.
  /// Cero significa que todas la necesitan; un monto muy alto, ninguna.
  montoAutorizacion Float   @default(0)
  /// Horas de trabajo al dia de un tecnico. Es el piso: quien quiera precision
  /// lo ajusta por persona en User.horasDisponibles.
  ///
  /// De aqui sale si un dia esta sobrecargado. Sin este numero el calendario
  /// puede mostrar 38 horas de trabajo asignadas al mismo martes y verse
  /// perfectamente normal.
  horasJornada      Float   @default(8)
  /// Dias de la semana que se trabajan, separados por coma: 1 es lunes y 7 es
  /// domingo. Texto y no arreglo, porque el esquema corre en SQLite y en
  /// PostgreSQL con el mismo archivo.
  diasHabiles       String  @default("1,2,3,4,5")

  /// Si una OT puede juntar actividades de varios origenes (preventivo del
  /// plan + un correctivo + una mejora) en un solo esfuerzo.
  ///
  /// Encendido por omision porque es como trabaja la gente en campo: se
  /// aprovecha la vuelta. Quien prefiera una OT por origen lo apaga y los
  /// selectores desaparecen del formulario.
  otMultiOrigen   Boolean @default(true)
  /// Dias hacia adelante que se ofrecen al elegir actividades programadas para
  /// sumar a una OT. Determina que tan lejos puede adelantarse trabajo.
  otHorizonteDias Int     @default(15)

  /// Contar los intervalos EN DIAS como dias habiles en vez de corridos.
  ///
  /// No es lo mismo contar habiles que recorrer al siguiente habil, que es lo
  /// unico que hacia el sistema: recorrer ajusta el resultado, contar cambia
  /// el resultado. Del viernes 4 de septiembre, "cada 15 dias" cae el sabado
  /// 19 contando corridos y el martes 22 contando habiles en una planta de
  /// lunes a sabado. Tres dias sobre el mismo dato, y las dos formas son
  /// legitimas: hay quien programa por almanaque y quien programa por
  /// desgaste, que ocurre operando.
  ///
  /// NO trae su propia lista de dias: usa `diasHabiles` y los festivos de la
  /// pestana "Jornada y calendario", los mismos que ya usan la carga del
  /// personal y el recorrido de vencimientos. Un solo lugar decide que dia es
  /// habil.
  ///
  /// Apagado por omision porque es lo que el sistema hace hoy. Prenderlo NO
  /// recalcula lo ya programado: mover de golpe el programa anual de una
  /// planta sin que nadie lo pidiera es peor que la inconsistencia de que
  /// convivan dos formas de contar durante un ciclo.
  ///
  /// Aplica SOLO a los intervalos en dias. Un trimestre son tres meses aunque
  /// la planta cierre dos semanas.
  otDiasHabiles Boolean @default(false)

  /// Quien arma las ordenes preventivas: AUTOMATICA | MANUAL.
  ///
  /// AUTOMATICA —lo de siempre— deja que el programador junte en una orden
  /// todo lo que le toca a un equipo dentro de la ventana.
  ///
  /// MANUAL es para el departamento donde el gestor decide que va en cada
  /// orden: de un plan de cinco actividades que caen la misma semana manda tres
  /// con un tecnico y dos con otro. Ahi el programador automatico le ganaria la
  /// mano armando una sola orden con las cinco antes de que el decida. En MANUAL
  /// el programador NO crea ordenes de calendario: avisa una vez al dia cuantas
  /// actividades estan atrasadas sin orden, porque apagarlo sin avisar seria
  /// dejar vencer el mantenimiento en silencio.
  ///
  /// Los planes POR MEDIDOR siguen automaticos en los dos modos: todavia no
  /// tienen reloj por actividad, y en MANUAL no habria quien los programara.
  otGeneracion String @default("AUTOMATICA")

  /// Pedir al menos un archivo de evidencia al completar ordenes de equipos
  /// criticos (A) o de seguridad. Apagado por omision: la evidencia no aporta
  /// lo mismo en todas las ordenes y exigirla siempre llena el sistema de fotos
  /// de relleno.
  otEvidenciaCriticas Boolean @default(false)

  /// Desde donde se cuenta el siguiente preventivo: CIERRE | PROGRAMADO.
  ///
  /// CIERRE —lo de siempre— cuenta desde que se hizo de verdad. Si el
  /// engrasado tocaba el 1 y se hizo el 15, el siguiente es 30 dias despues
  /// del 15. Es lo correcto para trabajo por desgaste: lo que importa es
  /// cuanto lleva operando desde la ultima vez.
  ///
  /// PROGRAMADO cuenta desde la fecha en que TOCABA. El calendario no se
  /// desplaza: la inspeccion mensual sigue cayendo el dia 1 aunque un mes se
  /// haya hecho tarde. Es lo correcto para trabajo anclado al calendario, y
  /// para quien reporta cumplimiento contra un programa anual.
  ///
  /// Ninguno de los dos salta actividades: el contador de ejecuciones avanza
  /// de uno en uno, asi que un cierre tardio mueve la fecha pero nunca se
  /// brinca el ciclo que tocaba.
  recalculoPlan String @default("CIERRE")

  /// ─── Lo que la empresa hace, en sus propias palabras ───────────────────
  ///
  /// El giro y el tipo de instalacion dicen la CATEGORIA: "planta
  /// metalmecanica". Eso no dice que trabaja tres turnos, que su cuello de
  /// botella es la grua, ni que este ano quiere certificarse. La diferencia
  /// entre un hallazgo y un consejo esta justo ahi.
  ///
  /// Son cinco campos y no un recuadro vacio a proposito: un "describa su
  /// empresa" en blanco recibe una linea o nada. Cada pregunta se eligio por
  /// lo que cambia en la respuesta de la IA, no por completar una ficha.
  ///
  /// Entran a los prompts como DATO delimitado, nunca como instruccion.

  /// Que produce y para quien. Cambia que significa "critico" en esta planta.
  queProduce     String?
  /// Turnos, dias, temporada alta. De aqui sale cuanto cuesta de verdad un
  /// paro planeado: en domingo sin produccion no cuesta lo mismo.
  comoOpera      String?
  /// La restriccion: que NO puede parar. Es el campo mas valioso de los cinco.
  /// "Sin la grua no se mueve material" explica de golpe por que ocho paros
  /// cortos duelen mas que cuatro largos, y eso ningun numero lo dice.
  noPuedeParar   String?
  /// El problema que el dueno reconoce hoy. Le da un blanco al analisis.
  dueleHoy       String?
  /// Que quiere lograr este ano. Convierte el hallazgo en recomendacion.
  objetivoDelAno String?
  /// Cuando se actualizo por ultima vez.
  ///
  /// Un contexto de hace dos anos describe una empresa que ya no existe, y la
  /// IA lo tomaria como cierto. Se muestra la fecha para que se note viejo.
  contextoAt     DateTime?

  /// Si esta organizacion manda avisos al celular de su gente.
  ///
  /// Apagado por omision, y a proposito. Un aviso que llega al telefono
  /// interrumpe a una persona: eso se pide, no se impone. Ademas, encenderlo
  /// sin explicarle a nadie como instalar la aplicacion solo produce la queja
  /// de que "no llegan los avisos" cuando en realidad nadie se suscribio.
  ///
  /// Apagarlo no borra las suscripciones: se dejan de usar y vuelven a servir
  /// si se enciende otra vez. Quien se dio de baja no tiene por que volver a
  /// hacer el tramite en el telefono por una decision de la empresa.
  avisosPush         Boolean   @default(false)
  /// Complemento "IA Avanzada" contratado sobre el plan.
  iaComplemento      Boolean   @default(false)
  /// Operaciones de IA sueltas compradas fuera del plan, del periodo en curso.
  iaExtra            Int       @default(0)
  /// Direccion del aviso de privacidad de la empresa, si tiene uno propio.
  /// Se enlaza desde el formulario publico del QR. Vacio: se enlaza el aviso
  /// del sistema, que explica que se hace con los datos de quien reporta.
  avisoPrivacidadUrl String?
  /// Cuando la empresa declaro que empieza a operar de verdad.
  ///
  /// Antes de esta fecha la cuenta esta en puesta en marcha: se vale cargar
  /// datos de demostracion, importar y corregir. Para ponerla no puede quedar
  /// ningun dato de demostracion vivo: asi los ejemplos nunca se cuelan en los
  /// indicadores de una empresa que ya opera. Nula = todavia no arranca.
  operandoDesde      DateTime?
  /// Quién declaró que la empresa empieza a operar. Junto con la fecha, es lo
  /// que distingue el estado OPERATIVO (en configuración, lista, operando) del
  /// COMERCIAL (prueba, activa, suspendida): una empresa puede estar pagando y
  /// todavía sin configurar.
  operandoPorId      String?

  /// Bloque 7. Empresa demostrativa: sin cobranza, sin cambios de plan ni
  /// credenciales, con su recorrido y su ayuda de demostracion, y
  /// restaurable a su estado inicial (lib/demo-comercial.ts).
  esDemo               Boolean   @default(false)
  /// Mientras se restaura, la demo no atiende peticiones (lib/api.ts).
  demoRestaurandoDesde DateTime?
  demoRestauradaAt     DateTime?
  /// Documentos aceptados al contratar (lib/legal.ts), y quien los acepto.
  terminosVersion      String?
  terminosAceptadosAt  DateTime?
  terminosAceptadosPor String?
  /// Como nacio la cuenta: REGISTRO | OPERADOR | DEMO
  origenAlta           String?
  spSequence           Int       @default(0)
  /// Los modulos que la empresa dijo que NO usara, en JSON: {"almacen":false}.
  /// Un paso de la puesta en marcha que la empresa no va a usar se muestra
  /// como «no aplica» y no le baja el avance. Sin decidir = se espera.
  modulosPuesta        String    @default("{}")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  users              User[]
  sites              Site[]
  locations          Location[]
  assetCategories    AssetCategory[]
  assets             Asset[]
  meters             Meter[]
  meterReadings      MeterReading[]
  plans              MaintenancePlan[]
  conjuntos          Conjunto[]
  conjuntoAssets     ConjuntoAsset[]
  workOrders         WorkOrder[]
  workRequests       WorkRequest[]
  parts              Part[]
  partCategories     PartCategory[]
  partUnits          PartUnit[]
  aiUsage            AiUsage[]
  aiReports          AiReport[]
  assetIntakes       AssetIntake[]
  specialties        Specialty[]
  externalServices   ExternalService[]
  vigencias          Vigencia[]
  centrosDeCosto     CentroDeCosto[]
  favoritos          PantallaFavorita[]
  stockMovements     StockMovement[]
  suppliers          Supplier[]
  teams              Team[]
  sensors            Sensor[]
  sensorReadings     SensorReading[]
  alerts             PredictiveAlert[]
  failureCodes       FailureCode[]
  rootCauses         RootCause[]
  notifications      Notification[]
  pushSubscriptions  PushSubscription[]
  entregasAviso      EntregaAviso[]
  historialAvisos    HistorialAviso[]
  configAvisos       ConfigAvisos?
  escalamientos      Escalamiento[]
  credencialesApi    CredencialApi[]
  webhooks           Webhook[]
  auditLogs          AuditLog[]
  attachments        Attachment[]
  links              ReferenceLink[]
  invites            Invitation[]
  planRequests       PlanRequest[]
  invoices           Invoice[]
  solicitudesSoporte SolicitudSoporte[]
  warehouses         Warehouse[]
  partStocks         PartStock[]
  stockTransfers     StockTransfer[]
  materialRequests   MaterialRequest[]
  purchaseRequests   PurchaseRequest[]
  goodsReceipts      GoodsReceipt[]
  quotes             Quote[]
  purchaseOrders     PurchaseOrder[]
  inventoryCounts    InventoryCount[]
  reportPoints       ReportPoint[]
  rondines           Rondin[]
  rondinParadas      RondinParada[]
  rondinHallazgos    RondinHallazgo[]
  festivos           DiaFestivo[]
  equivalencias      EquivalenciaRefaccion[]
  asignacionesPlan   PlanAsset[]
  calendariosTarea   PlanTaskAsset[]
  revisionesAgenda   RevisionAgenda[]
  passwordResets     PasswordReset[]
  importBatches      ImportBatch[]
  downtimeEvents     DowntimeEvent[]
  resumenInicio      ResumenInicio?
  comentarios        Comentario[]
  observadores       Observador[]
  compromisos        Compromiso[]
}

model User {
  id                String    @id @default(cuid())
  organizationId    String
  email             String    @unique
  name              String
  passwordHash      String
  role              String    @default("TECHNICIAN") // OWNER|ADMIN|SUPERVISOR|TECHNICIAN|REQUESTER|VIEWER
  /// Operador de la plataforma. Trasciende la organizacion: puede dar de alta
  /// empresas cliente y entrar a cualquiera de ellas. No es un rol mas de la
  /// lista de arriba, porque esos son siempre dentro de UNA organizacion.
  isSuperAdmin      Boolean   @default(false)
  phone             String?
  jobTitle          String?
  employeeNo        String?
  hourlyRate        Float     @default(0)
  color             String    @default("#2563eb")
  active            Boolean   @default(true)
  lastLoginAt       DateTime?
  /// Desde cuando valen las sesiones de esta persona.
  ///
  /// La sesion es un JWT firmado de siete dias: una vez emitido, nadie lo puede
  /// retirar. Con esta fecha si: al cambiar la contrasena, al cambiarle el rol
  /// o al cerrar sesion en todos lados se pone «ahora», y toda sesion emitida
  /// antes deja de servir en la siguiente peticion. Nula = valen todas.
  sessionsValidFrom DateTime?
  /// NORMAL | GRANDE | MAYOR
  escalaUi          String    @default("NORMAL")
  /// COMPACTA | COMODA | AMPLIA
  densidadUi        String    @default("COMODA")
  /// Como quiere ver cada tabla del sistema: que columnas, en que orden y con
  /// que agrupacion. Es un objeto por tabla —activos, ordenes, refacciones,
  /// planes— para no agregar una columna cada vez que otra lista se vuelve
  /// configurable. Va por usuario y no por organizacion porque el almacenista
  /// y el jefe de mantenimiento no miran lo mismo.
  vistasTabla       String    @default("{}")
  /// Con que voz quiere oir el parte del dia (lib/voz.ts). Nula = la de
  /// omision. Va por usuario y no por empresa porque es una preferencia de
  /// oido, como la escala de letra: al director le puede gustar una y a su
  /// jefe de mantenimiento otra.
  vozBrief          String?
  /// Que tan larga quiere la respuesta HABLADA: CONCISA o COMPLETA
  /// (lib/respuestas-voz.ts). Nula = concisa, que es la de omision.
  ///
  /// Solo manda sobre lo que se DICE. Lo escrito sale completo siempre: el
  /// contexto de mas si vale —«ojo, la mitad no tiene causa raiz»— y tirarlo
  /// seria resolver un problema creando otro. Rafael lo midio en su telefono:
  /// preguntar «cuantos activos tenemos» y oir cincuenta segundos de informe.
  respuestaVoz      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization         Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  teamMemberships      TeamMember[]
  assignedWorkOrders   WorkOrder[]             @relation("WorkOrderAssignee")
  createdWorkOrders    WorkOrder[]             @relation("WorkOrderCreator")
  laborEntries         WorkOrderLabor[]
  comments             WorkOrderComment[]
  requests             WorkRequest[]           @relation("RequestAuthor")
  reviewedRequests     WorkRequest[]           @relation("RequestReviewer")
  meterReadings        MeterReading[]
  stockMovements       StockMovement[]
  notifications        Notification[]
  pushSubscriptions    PushSubscription[]
  preferenciaAvisos    PreferenciaAvisos?
  auditLogs            AuditLog[]
  passwordResets       PasswordReset[]         @relation("ResetDeUsuario")
  resetsEmitidos       PasswordReset[]         @relation("ResetEmitidoPor")
  acknowledgedAlerts   PredictiveAlert[]
  completedTasks       WorkOrderTask[]
  attachments          Attachment[]
  vigencias            Vigencia[]              @relation("VigenciaDeUsuario")
  vigenciasCreadas     Vigencia[]              @relation("VigenciaAutor")
  favoritos            PantallaFavorita[]
  links                ReferenceLink[]
  planRequests         PlanRequest[]
  solicitudesSoporte   SolicitudSoporte[]
  aiUsage              AiUsage[]
  assetIntakes         AssetIntake[]
  warehousesACargo     Warehouse[]
  stockTransfers       StockTransfer[]
  materialRequests     MaterialRequest[]
  purchaseRequests     PurchaseRequest[]       @relation("CompraSolicitante")
  purchaseAuthorized   PurchaseRequest[]       @relation("CompraAutorizador")
  goodsReceipts        GoodsReceipt[]
  quotesCapturadas     Quote[]
  purchaseOrders       PurchaseOrder[]
  inventoryCounts      InventoryCount[]
  rondines             Rondin[]
  rondinHallazgos      RondinHallazgo[]
  reportPoints         ReportPoint[]
  tareasLiberadas      WorkOrderTask[]         @relation("TareaLiberadaPor")
  /// Horas disponibles al dia de esta persona. Nulo usa la jornada de la
  /// organizacion: se define por excepcion, no llenando un campo por empleado.
  horasDisponibles     Float?
  festivos             DiaFestivo[]            @relation("FestivoCreadoPor")
  equivalenciasCreadas EquivalenciaRefaccion[] @relation("EquivalenciaCreadaPor")
  asignacionesCreadas  PlanAsset[]             @relation("AsignacionCreadaPor")
  conjuntosACargo      Conjunto[]              @relation("ConjuntoResponsable")
  comentarios          Comentario[]
  menciones            ComentarioMencion[]
  observa              Observador[]
  compromisos          Compromiso[]            @relation("CompromisoResponsable")
  compromisosCreados   Compromiso[]            @relation("CompromisoAutor")

  @@index([organizationId])
}

model Invitation {
  id             String   @id @default(cuid())
  organizationId String
  email          String
  role           String   @default("TECHNICIAN")
  token          String   @unique
  status         String   @default("PENDING") // PENDING | ACCEPTED | REVOKED
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

/// Una importacion —o una carga de datos de demostracion— como unidad.
///
/// Sin esto una importacion era una linea en la bitacora: no se sabia que
/// registros habia creado, y deshacerla era buscar a mano. Ahora cada lote
/// sabe quien lo hizo, de que archivo —su huella, no su contenido—, cuantos
/// creo, actualizo y rechazo, y cuales son exactamente sus registros.
///
/// Los datos de demostracion son un lote de tipo DEMO: se eliminan con la misma
/// reversion segura que una importacion, que no toca lo que ya se uso.
model ImportBatch {
  id             String    @id @default(cuid())
  organizationId String
  userId         String?
  /// sitios | activos | refacciones | ... | DEMO
  tipo           String
  archivoNombre  String?
  /// SHA-256 del archivo. Identifica cual fue sin guardar su contenido.
  archivoHuella  String?
  /// VALIDADA | CONFIRMADA | COMPLETADA | COMPLETADA_CON_ADVERTENCIAS | FALLIDA | REVERTIDA | REVERSION_PARCIAL | REVERSION_BLOQUEADA
  estado         String
  leidos         Int       @default(0)
  creados        Int       @default(0)
  actualizados   Int       @default(0)
  omitidos       Int       @default(0)
  rechazados     Int       @default(0)
  /// Resumen de lo que paso, en JSON: motivo de falla o detalle de reversion.
  detalle        String    @default("{}")
  revertidoAt    DateTime?
  revertidoPorId String?
  createdAt      DateTime  @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  registros    ImportRecord[]

  @@index([organizationId, createdAt])
}

/// Un registro que tocó un lote: cual, de que tipo, y si lo creo o lo actualizo.
model ImportRecord {
  id       String  @id @default(cuid())
  batchId  String
  /// Site | Location | Asset | Part | Supplier | MaintenancePlan | ...
  entity   String
  entityId String
  /// CREATED | UPDATED | REVERTED (anulado o compensado por una reversion)
  accion   String
  /// Los valores anteriores de un registro actualizado, para poder revisarlo.
  antes    String?

  batch ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([entity, entityId])
}

/// Restablecimiento de contrasena: un solo uso y con vencimiento.
///
/// El token en claro NO se guarda: solo su hash. Quien tenga acceso a la base
/// no puede entrar con lo que ahi vea, y la liga sirve una sola vez. Las emite
/// la administracion de la empresa para su propia gente —no hay correo saliente
/// todavia— y por eso lleva quien la genero.
model PasswordReset {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  tokenHash      String    @unique
  expiresAt      DateTime
  usedAt         DateTime?
  createdById    String?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation("ResetDeUsuario", fields: [userId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("ResetEmitidoPor", fields: [createdById], references: [id])

  @@index([userId])
  @@index([organizationId])
}

/// Intento de entrada al sistema.
///
/// Existe para dos cosas: frenar a quien prueba contrasenas una tras otra, y
/// poder responder «quien entro y cuando» sin depender de los registros de
/// Cloud Run. No guarda la contrasena ni nada parecido, solo el correo tecleado.
model AccessAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String?
  exito     Boolean  @default(false)
  /// CLAVE_MAL | SIN_CUENTA | BLOQUEADO | EMPRESA_SUSPENDIDA | OK
  motivo    String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

model Team {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  color          String   @default("#0ea5e9")
  createdAt      DateTime @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      TeamMember[]
  workOrders   WorkOrder[]
  plans        MaintenancePlan[]

  @@index([organizationId])
}

model TeamMember {
  id     String @id @default(cuid())
  teamId String
  userId String

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

// --------------------------------------------------------------- Ubicacion ---

model Site {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  code           String
  address        String?
  city           String?
  country        String?  @default("Mexico")
  /// Coordenadas del sitio. Alimentan el enlace al mapa y, sobre todo, el
  /// contexto ambiental con el que la IA propone frecuencias de mantenimiento.
  latitud        Float?
  longitud       Float?
  /// Como se entra: caseta, horario, si pasa trailer, donde esta el anden.
  /// Lo que un proveedor externo necesita saber la primera vez que llega.
  notasAcceso    String?
  timezone       String   @default("America/Mexico_City")
  createdAt      DateTime @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  locations    Location[]
  assets       Asset[]
  workOrders   WorkOrder[]
  requests     WorkRequest[]
  warehouses   Warehouse[]
  reportPoints ReportPoint[]
  rondines     Rondin[]

  conjuntos Conjunto[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model Location {
  id             String  @id @default(cuid())
  organizationId String
  siteId         String
  parentId       String?
  name           String
  code           String
  description    String?
  /// ─── El croquis: donde queda esta area en la planta ───────────────────
  ///
  /// El mapa de calor dibujado como tira proporcional dice DONDE DUELE, pero
  /// no se parece a la planta de nadie. Un director piensa en lugares —"el
  /// area de tornos, alla al fondo"— y cuando el dibujo coincide con esa
  /// geografia mental deja de ser una grafica y pasa a ser SU planta.
  ///
  /// Va en celdas de una rejilla y no en pixeles: la rejilla perdona el pulso
  /// —nadie acomoda cajas al pixel con el dedo en una tableta— y el resultado
  /// se ve ordenado aunque se haya armado de prisa.
  ///
  /// Nulo en X/Y significa SIN COLOCAR. Mientras alguna area lo este, la
  /// pantalla cae a la tira proporcional: media planta dibujada y media no
  /// seria peor que ninguna.
  planoX         Int?
  planoY         Int?
  planoAncho     Int     @default(3)
  planoAlto      Int     @default(2)

  /// Lo que esta area o linea DEJA DE GANAR por cada hora parada.
  ///
  /// Margen, no venta. Un numero de precio de venta sale enorme y se ve
  /// espectacular, pero lo tumba la primera persona que pregunte si de verdad
  /// se perdio la venta o se recupero el sabado con tiempo extra, y si se
  /// resto el material que no se consumio. Un numero que tumban una vez
  /// desacredita todo el tablero, incluidas las partes correctas.
  ///
  /// Cero significa SIN CAPTURAR, no "parar aqui es gratis". La diferencia
  /// importa al presentarlo: un area sin tarifa no debe salir en $0, debe
  /// salir como pendiente de definir.
  margenPorHora Float    @default(0)
  createdAt     DateTime @default(now())

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site          Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  parent        Location?      @relation("LocationTree", fields: [parentId], references: [id])
  children      Location[]     @relation("LocationTree")
  assets        Asset[]
  workOrders    WorkOrder[]
  requests      WorkRequest[]
  reportPoints  ReportPoint[]
  rondines      Rondin[]
  rondinParadas RondinParada[]

  @@index([organizationId])
  @@index([siteId])
}

// ------------------------------------------------------------------ Activos ---

model AssetCategory {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  code           String
  icon           String?
  createdAt      DateTime @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assets       Asset[]
  plans        MaintenancePlan[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model Asset {
  id                String    @id @default(cuid())
  organizationId    String
  siteId            String
  locationId        String?
  categoryId        String?
  /// A que centro de costo pertenece el equipo. La orden lo hereda de aqui.
  centroDeCostoId   String?
  parentId          String?
  code              String
  name              String
  description       String?
  manufacturer      String?
  model             String?
  serialNumber      String?
  criticality       String    @default("B") // A | B | C
  /// Si parar este equipo DETIENE la produccion de su ubicacion.
  ///
  /// Sin esta marca, el costo del paro seria mentira: al extractor de humos o
  /// a la bomba de respaldo se les cargaria la tarifa completa de la nave, y
  /// el dueno lo cacharia a la primera —con razon—, que es como se pierde la
  /// confianza en un tablero entero.
  ///
  /// Nulo a proposito: significa QUE NADIE LO HA DICHO, no "no detiene". Un
  /// falso por omision daria un total bajo que parece exacto; un verdadero por
  /// omision daria uno inflado. Nulo obliga a que la pantalla muestre cuantos
  /// equipos faltan por definir, y convierte el hueco en tarea visible en vez
  /// de en un numero equivocado.
  ///
  /// No se deduce de `criticality`: la criticidad habla de consecuencia en
  /// general —seguridad, costo, normativa— y esto habla solo de si se detiene
  /// la produccion. Un equipo critico por seguridad puede no parar la linea.
  detieneLinea      Boolean?
  status            String    @default("OPERATIONAL") // OPERATIONAL|DEGRADED|DOWN|STANDBY|RETIRED
  purchaseDate      DateTime?
  purchaseCost      Float     @default(0)
  replacementCost   Float     @default(0)
  warrantyExpiry    DateTime?
  commissionedAt    DateTime?
  expectedLifeYears Int?
  /// Ultimo analisis de recurrencia de fallas, en JSON, y cuando se hizo. Se
  /// guarda para no volver a pagarlo cada vez que alguien abre la ficha.
  /// Este equipo va solo, y es una decision, no un pendiente.
  ///
  /// Un equipo que no esta en ningun conjunto puede ser dos cosas muy
  /// distintas: nadie lo ha acomodado todavia —eso es tarea— o alguien ya
  /// decidio que no pertenece a ninguno, como el calentador del bano de
  /// oficinas. Sin distinguirlas, la lista de pendientes se llena de cosas
  /// que nunca se van a mover, se vuelve ruido, y el dia que de verdad falte
  /// acomodar algo importante ya nadie la esta viendo.
  ///
  /// Misma regla que detieneLinea: lo que nadie ha decidido se ve como hueco;
  /// lo decidido se guarda y el sistema deja de preguntar.
  independiente     Boolean   @default(false)

  iaRecurrencia   String?
  iaRecurrenciaEl DateTime?
  imageUrl        String?
  qrToken         String    @unique @default(cuid())
  specsJson       String    @default("{}")
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site             Site              @relation(fields: [siteId], references: [id], onDelete: Cascade)
  location         Location?         @relation(fields: [locationId], references: [id])
  category         AssetCategory?    @relation(fields: [categoryId], references: [id])
  centroDeCosto    CentroDeCosto?    @relation(fields: [centroDeCostoId], references: [id])
  parent           Asset?            @relation("AssetTree", fields: [parentId], references: [id])
  children         Asset[]           @relation("AssetTree")
  meters           Meter[]
  sensors          Sensor[]
  plans            MaintenancePlan[]
  workOrders       WorkOrder[]
  requests         WorkRequest[]
  alerts           PredictiveAlert[]
  downtimes        DowntimeEvent[]
  requisiciones    MaterialRequest[]
  rondinParadas    RondinParada[]
  rondinHallazgos  RondinHallazgo[]
  attachments      Attachment[]
  vigencias        Vigencia[]
  links            ReferenceLink[]
  reportPoints     ReportPoint[]
  planesAsignados  PlanAsset[]
  calendariosTarea PlanTaskAsset[]
  conjuntos        ConjuntoAsset[]
  comentarios      Comentario[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([siteId])
}

model DowntimeEvent {
  id String @id @default(cuid())

  /// Era el unico modelo grande sin empresa: TODAS las consultas de paro
  /// filtraban por `asset.organizationId`, asi que para pintar el indicador
  /// de una empresa habia que recorrer los paros de todas y unirlos con
  /// Activos. Se llena desde el activo (ver la migracion).
  organizationId String
  assetId        String
  workOrderId    String?
  startedAt      DateTime
  endedAt        DateTime?
  minutes        Int       @default(0)
  planned        Boolean   @default(false)
  reason         String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  asset        Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  workOrder    WorkOrder?   @relation(fields: [workOrderId], references: [id])

  @@index([assetId])
  @@index([organizationId, startedAt])
  @@index([assetId, startedAt])
}

// ---------------------------------------------------------------- Medidores ---

model Meter {
  id             String    @id @default(cuid())
  organizationId String
  assetId        String
  name           String
  unit           String    @default("h") // h | km | ciclos | pzas
  currentValue   Float     @default(0)
  dailyAverage   Float     @default(0)
  lastReadingAt  DateTime?
  createdAt      DateTime  @default(now())

  /// HOROMETRO | ODOMETRO | CICLOS | OTRO. Decide que lectura es imposible:
  /// un horometro no puede sumar mas horas que las que pasaron en el reloj.
  /// Los existentes se derivaron de la unidad en la migracion.
  tipo String @default("HOROMETRO")

  /// Uso maximo razonable por dia (km/dia, ciclos/dia...). Arriba de esto la
  /// lectura se trata como atipica y pide confirmacion con justificacion.
  /// Nulo: sin limite configurado. En horometros solo puede bajar de 24.
  maxIncrementoDiario Float?

  /// Valor inicial registrado formalmente al dar de alta el medidor. Es lo
  /// unico que vale como "actual" cuando no queda ninguna lectura vigente.
  valorInicial   Float?
  valorInicialEl DateTime?

  /// Falso cuando todas las lecturas estan anuladas y no hay valor inicial:
  /// el medidor se muestra "Sin lectura vigente" y no se proyecta nada.
  lecturaVigente Boolean @default(true)

  /// Verdadero cuando alguna lectura vigente es invalida (menor que la anterior
  /// o fisicamente imposible). Ninguna pantalla presenta fecha estimada ni el
  /// programador genera por uso hasta que la lectura se corrija o se anule; el
  /// recalculo lo apaga solo. `motivoSuspension` dice cual lectura y por que.
  proyeccionSuspendida Boolean @default(false)
  motivoSuspension     String?

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  asset        Asset             @relation(fields: [assetId], references: [id], onDelete: Cascade)
  readings     MeterReading[]
  plans        MaintenancePlan[]
  asignaciones PlanAsset[]

  @@index([organizationId])
  @@index([assetId])
}

model MeterReading {
  id             String   @id @default(cuid())
  organizationId String
  meterId        String
  userId         String?
  value          Float
  delta          Float    @default(0)
  readingAt      DateTime @default(now())
  source         String   @default("MANUAL") // MANUAL | IOT | IMPORT
  note           String?

  /// LECTURA | REINICIO | SUSTITUCION. Un reinicio o un medidor nuevo es el
  /// unico caso en que el valor puede bajar, y corta el calculo de uso: el
  /// incremento no se mide contra el medidor anterior.
  tipo String @default("LECTURA")

  /// VALIDA | CORREGIDA | ANULADA. Nunca se borra una lectura: se corrige
  /// conservando el valor original o se anula con motivo, y el promedio y los
  /// planes se recalculan sin ella.
  estado String @default("VALIDA")

  /// Se aceptó fuera de lo razonable, con confirmacion y justificacion.
  atipica       Boolean @default(false)
  justificacion String?

  /// El valor tal como se capturo la primera vez, si luego se corrigio.
  valorOriginal    Float?
  fechaOriginal    DateTime?
  /// El tipo con que se capturo, si una correccion lo cambio (p. ej. un
  /// reinicio que era sustitucion).
  tipoOriginal     String?
  /// En un REINICIO o SUSTITUCION: el valor del medidor justo antes. Con el se
  /// recorren los planes al registrarlo y se deshace al anularlo o corregirlo.
  valorAnterior    Float?
  correccionPorId  String?
  correccionEl     DateTime?
  correccionMotivo String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  meter        Meter        @relation(fields: [meterId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])

  @@index([meterId])
  @@index([organizationId])
  @@index([meterId, readingAt])
}

// --------------------------------------------------- Planes de mantenimiento ---

model MaintenancePlan {
  id               String    @id @default(cuid())
  organizationId   String
  assetId          String?
  /// El TIPO de equipo al que pertenece este plan.
  ///
  /// Un plan de «Preventivo mensual compresor» pertenece a la categoria
  /// COMPRESORES: eso permite aplicarlo a los cuatro de un golpe en vez de
  /// buscarlos uno por uno, y —lo que de verdad importa— darse cuenta cuando
  /// entra un compresor nuevo que se quedo sin plan.
  ///
  /// Un equipo sin preventivo porque nadie se acordo de agregarlo es una falla
  /// que no avisa hasta que el equipo se para.
  categoryId       String?
  meterId          String?
  teamId           String?
  assignedToId     String?
  name             String
  description      String?
  maintenanceType  String    @default("PREVENTIVE") // PREVENTIVE | PREDICTIVE | INSPECTION
  triggerType      String    @default("CALENDAR") // CALENDAR | METER | CONDITION
  intervalDays     Int?
  intervalMeter    Float?
  leadTimeDays     Int       @default(3)
  toleranceDays    Int       @default(2)
  priority         String    @default("MEDIUM")
  estimatedHours   Float     @default(1)
  requiresShutdown Boolean   @default(false)
  procedure        String?
  safetyNotes      String?
  active           Boolean   @default(true)
  /// OBSOLETOS: el calendario vive en PlanAsset, uno por activo.
  ///
  /// Se conservan porque un plan con un solo activo los sigue mostrando en
  /// pantallas viejas y borrarlos ahora seria una migracion destructiva sin
  /// necesidad. El programador ya NO los lee.
  lastGeneratedAt  DateTime?
  lastCompletedAt  DateTime?
  nextDueDate      DateTime?
  nextDueMeter     Float?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  asset        Asset?          @relation(fields: [assetId], references: [id], onDelete: Cascade)
  category     AssetCategory?  @relation(fields: [categoryId], references: [id])
  meter        Meter?          @relation(fields: [meterId], references: [id])
  team         Team?           @relation(fields: [teamId], references: [id])
  tasks        PlanTask[]
  workOrders   WorkOrder[]
  links        ReferenceLink[]
  asignaciones PlanAsset[]

  @@index([organizationId])
  @@index([assetId])
}

model PlanTask {
  id          String  @id @default(cuid())
  planId      String
  position    Int     @default(0)
  title       String
  description String?
  taskType    String  @default("CHECK") // CHECK | MEASURE | TEXT | REPLACE

  /// Cada cuantas ejecuciones del plan toca esta actividad.
  ///
  /// La frecuencia vive AQUI y no solo en el plan porque no es la misma para
  /// todo: el aceite se cambia cada mes y el liquido de frenos cada seis. Con
  /// la frecuencia unica del plan, o se cambia el aceite de mas o el filtro de
  /// menos, y no avisa.
  ///
  /// Se midio antes de decidirlo: de 24 asignaciones en produccion, 23 son un
  /// equipo con UN solo plan. El diseño pedia partir en varios planes cuando
  /// las frecuencias difieren, y nadie lo hacia. Un diseño que exige algo que
  /// nadie hace no es un diseño.
  ///
  /// Es un MULTIPLO de la cadencia base del plan, no dias. Asi el anidamiento
  /// sale gratis: en la ejecucion 6 entran las de cada 1, cada 2, cada 3 y
  /// cada 6 —una sola visita, una sola orden— que es justo lo que ningun
  /// arreglo con varios planes puede dar sin logica de mezcla.
  ///
  /// En 1 el comportamiento es identico al de siempre: sale en cada ejecucion.
  ///
  /// OBSOLETO desde el calendario por actividad. Lo lee nadie: la frecuencia
  /// real vive en `cadaCuanto` + `unidadFrecuencia`, que no obliga a que todas
  /// las actividades sean multiplos de una misma cadencia. Se midio por que:
  /// con actividades semanales y mensuales —la combinacion mas comun que
  /// existe— el maximo comun divisor es 1, la cadencia base se colapsa a un
  /// dia, y el programador daba 365 vueltas al ano de las cuales 302 no
  /// producian nada.
  ///
  /// No se borra en esta migracion a proposito: si el calendario nuevo sale
  /// mal en produccion quiero poder volver sin haber perdido el dato. Se
  /// retira cuando lleve tiempo corriendo.
  cadaCuantas Int @default(1)

  /// Cada cuanto toca ESTA actividad, en la unidad de al lado.
  ///
  /// Nulo mientras no se ha migrado; entonces manda la cadencia del plan. Toda
  /// actividad nueva lo trae.
  cadaCuanto       Int?
  /// DIAS | SEMANAS | MESES.
  ///
  /// Tres unidades y no una porque no son la misma operacion. "Mensual" como
  /// 30 dias se corre cinco dias al ano; como mes de calendario cae siempre el
  /// mismo dia. Y "cada 15 dias" puede querer decir 15 dias de trabajo, que es
  /// lo que significa para una maquina que se desgasta operando.
  ///
  /// "Cada lunes" no necesita un tipo propio: es una semana anclada en lunes,
  /// y el ancla la pone `PlanTaskAsset`.
  unidadFrecuencia String @default("DIAS")

  /// Una frecuencia diaria es valida en rutinas de turno, pero tambien es el
  /// error de captura mas caro (365 visitas al ano). Se confirma explicitamente
  /// y se guarda quien y cuando; nulo en una diaria = advertencia de calidad.
  diariaConfirmadaPorId String?
  diariaConfirmadaEl    DateTime?
  unit                  String?
  minValue              Float?
  maxValue              Float?
  required              Boolean   @default(true)

  plan        MaintenancePlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  labor       PlanTaskLabor[]
  parts       PlanTaskPart[]
  services    PlanTaskService[]
  calendarios PlanTaskAsset[]

  @@index([planId])
}

// ------------------------------------------------------------ Ordenes de trabajo ---

model WorkOrder {
  id               String    @id @default(cuid())
  organizationId   String
  number           String
  title            String
  description      String?
  maintenanceType  String    @default("CORRECTIVE") // PREVENTIVE|CORRECTIVE|PREDICTIVE|INSPECTION|SAFETY|IMPROVEMENT
  status           String    @default("OPEN") // DRAFT|OPEN|ASSIGNED|IN_PROGRESS|ON_HOLD|COMPLETED|CLOSED|CANCELLED
  priority         String    @default("MEDIUM") // LOW|MEDIUM|HIGH|CRITICAL
  assetId          String?
  /// A que centro de costo se carga ESTE trabajo.
  ///
  /// Se hereda del activo al crear la orden, y se puede cambiar: hay trabajos
  /// que no los paga el dueño del equipo —una modificacion que pide
  /// produccion, un montaje que carga a un proyecto—. Solo con el activo el
  /// caso se pierde; solo con la orden hay que capturarlo cada vez y nadie lo
  /// hace.
  ///
  /// Se copia, no se resuelve al vuelo: si el equipo cambia de centro el año
  /// que viene, lo ya gastado se queda donde se gasto. Recalcular el historico
  /// cambiaria los reportes del año pasado solos, y con eso el contador deja
  /// de confiar en el sistema.
  centroDeCostoId  String?
  siteId           String?
  locationId       String?
  planId           String?
  assignedToId     String?
  teamId           String?
  createdById      String?
  dueDate          DateTime?
  scheduledStart   DateTime?
  scheduledEnd     DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  closedAt         DateTime?
  estimatedHours   Float     @default(1)
  actualHours      Float     @default(0)
  downtimeMinutes  Int       @default(0)
  responseMinutes  Int?
  requiresShutdown Boolean   @default(false)
  failureCodeId    String?
  rootCauseId      String?
  resolution       String?
  procedure        String?
  safetyNotes      String?
  meterValue       Float?

  // ── Cierre y motivos (Bloque 1: proceso operativo) ──────────────────────
  /// Excepcion justificada al completar sin horas de mano de obra (p. ej. lo
  /// hizo un contratista cuyo costo va en servicios). Sin horas ni motivo no
  /// se puede completar.
  motivoSinHoras       String?
  /// Requeria paro pero al final no hubo: se confirma expresamente al
  /// completar. Distingue «no hubo paro» de «no se capturo».
  sinParoConfirmado    Boolean  @default(false)
  /// En una falla, por que queda sin codigo o sin causa raiz («Sin determinar»).
  motivoSinDiagnostico String?
  /// Por que esta en espera. Se limpia al reanudar; la historia queda en auditoria.
  motivoEspera         String?
  motivoCancelacion    String?
  laborCost            Float    @default(0)
  partsCost            Float    @default(0)
  serviceCost          Float    @default(0)
  otherCost            Float    @default(0)
  totalCost            Float    @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  organization  Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  asset         Asset?             @relation(fields: [assetId], references: [id])
  centroDeCosto CentroDeCosto?     @relation(fields: [centroDeCostoId], references: [id])
  site          Site?              @relation(fields: [siteId], references: [id])
  location      Location?          @relation(fields: [locationId], references: [id])
  plan          MaintenancePlan?   @relation(fields: [planId], references: [id])
  assignedTo    User?              @relation("WorkOrderAssignee", fields: [assignedToId], references: [id])
  createdBy     User?              @relation("WorkOrderCreator", fields: [createdById], references: [id])
  team          Team?              @relation(fields: [teamId], references: [id])
  failureCode   FailureCode?       @relation(fields: [failureCodeId], references: [id])
  rootCause     RootCause?         @relation(fields: [rootCauseId], references: [id])
  tasks         WorkOrderTask[]
  labor         WorkOrderLabor[]
  partsUsed     WorkOrderPart[]
  servicesUsed  WorkOrderService[]
  comments      WorkOrderComment[]
  attachments   Attachment[]
  requests      WorkRequest[]
  alerts        PredictiveAlert[]
  downtimes     DowntimeEvent[]
  stockMoves    StockMovement[]
  requisiciones MaterialRequest[]
  comentarios   Comentario[]

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([status])
  @@index([assetId])
  @@index([assignedToId])
  @@index([organizationId, status, dueDate])
  @@index([organizationId, completedAt])
  @@index([organizationId, createdAt])
  @@index([organizationId, maintenanceType, dueDate])
  @@index([assetId, createdAt])
}

model WorkOrderTask {
  id              String    @id @default(cuid())
  workOrderId     String
  position        Int       @default(0)
  /// De donde salio esta actividad: PLAN | SOLICITUD | BACKLOG | ALERTA | MANUAL.
  ///
  /// Una OT puede juntar actividades de varios origenes —el tecnico va a la
  /// bomba por el preventivo del mes y de paso atiende la fuga reportada— y
  /// sin este campo no habria forma de saber cual actividad cumplio que
  /// compromiso, ni de avanzar el plan correcto al cerrar.
  origen          String    @default("MANUAL")
  /// El plan que aporto esta actividad, si vino de uno. No se usa el planId de
  /// la OT: esa es una sola referencia y una OT mezclada puede traer
  /// actividades de dos planes distintos.
  planTaskId      String?
  origenPlanId    String?
  /// La solicitud de servicio que dio origen a esta actividad, si aplica.
  origenRequestId String?
  /// Tipo de mantenimiento de ESTA actividad, que puede diferir del de la OT.
  /// De aqui sale la clasificacion de paro planeado o no planeado: tomarla del
  /// encabezado contaria un correctivo colado en un preventivo como planeado.
  maintenanceType String?
  title           String
  description     String?
  taskType        String    @default("CHECK")
  unit            String?
  minValue        Float?
  maxValue        Float?
  required        Boolean   @default(true)
  done            Boolean   @default(false)
  resultText      String?
  resultNumber    Float?
  passed          Boolean?
  completedById   String?
  completedAt     DateTime?

  /// Cuando el tecnico libero esta actividad en vez de ejecutarla.
  ///
  /// La actividad NO se borra de la OT: se queda marcada como liberada. Asi la
  /// orden cuenta lo que de verdad paso ese dia —tres hechas, una liberada por
  /// falta de refaccion— en vez de que el trabajo pendiente desaparezca del
  /// registro. El backlog es una consulta sobre estas, no una tabla aparte.
  liberadaAt         DateTime?
  liberadaPorId      String?
  /// SIN_REFACCION | SIN_MANO_DE_OBRA | SERVICIO_EXTERNO | SIN_ACCESO | OTRO
  ///
  /// Estructurado y no texto libre porque de aqui salen las decisiones: con
  /// SIN_REFACCION y la refaccion identificada, el backlog puede decir cuales
  /// actividades ya se pueden hacer con lo que hay hoy en el almacen.
  motivoLiberacion   String?
  motivoDetalle      String?
  /// La refaccion que trabo la actividad, cuando el motivo es SIN_REFACCION.
  bloqueadaPorPartId String?
  /// Lo que costo ESTA actividad, sumando lo que se le cargo directamente.
  ///
  /// Se recalcula igual que el de la orden. Lo que no se pudo atribuir a
  /// ninguna actividad no entra aqui: vive solo en el total de la orden, y por
  /// eso la suma de las actividades puede ser menor que el total de la OT.
  laborCost          Float     @default(0)
  partsCost          Float     @default(0)
  serviceCost        Float     @default(0)
  totalCost          Float     @default(0)

  /// Por que fallo ESTA actividad. Vive aqui y no en el encabezado de la OT
  /// porque una orden mezclada puede traer varios reportes de falla —el
  /// preventivo del mes mas dos fugas reportadas— y un solo codigo en la
  /// cabecera no puede representar tres eventos distintos. El del encabezado
  /// se conserva para las ordenes viejas y se sigue leyendo, pero lo nuevo se
  /// captura aqui.
  ///
  /// Solo aplica a actividades cuyo maintenanceType es de falla (CORRECTIVE o
  /// SAFETY). Un preventivo que se ejecuto bien no es una falla, y codificarlo
  /// inventa un evento que despues ensucia el Pareto y el MTBF.
  failureCodeId   String?
  rootCauseId     String?
  /// Paro que causo esta actividad. Mismo motivo que arriba: el paro del
  /// encabezado no se puede repartir entre varias fallas.
  downtimeMinutes Int     @default(0)

  /// Cuando se aviso que esta actividad YA SE PUEDE hacer.
  ///
  /// El dato de que la refaccion llego siempre existio; lo que faltaba era que
  /// alguien se enterara. Este campo es la memoria de ese aviso: sin el, cada
  /// barrido volveria a avisar lo mismo y la gente dejaria de leerlos.
  ///
  /// Se limpia si la refaccion se vuelve a acabar, de modo que el aviso salga
  /// otra vez cuando vuelva a haber. Asi solo avisa en el cambio de "no se
  /// puede" a "si se puede", nunca mientras el estado se mantiene.
  avisoDisponibleAt DateTime?

  /// La actividad liberada que esta continua, cuando se retomo del backlog.
  ///
  /// Encadena el historial: liberada en una OT, retomada en otra, hecha. Saber
  /// cuantas veces se ha trabado algo es recorrer la cadena, no llevar un
  /// contador que se desincroniza.
  retomaDeTaskId String? @unique

  workOrder        WorkOrder             @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  completedBy      User?                 @relation(fields: [completedById], references: [id])
  liberadaPor      User?                 @relation("TareaLiberadaPor", fields: [liberadaPorId], references: [id])
  bloqueadaPor     Part?                 @relation(fields: [bloqueadaPorPartId], references: [id])
  cargosRefaccion  WorkOrderPart[]
  materialPedido   MaterialRequestLine[]
  cargosManoDeObra WorkOrderLabor[]
  cargosServicio   WorkOrderService[]
  failureCode      FailureCode?          @relation(fields: [failureCodeId], references: [id])
  rootCause        RootCause?            @relation(fields: [rootCauseId], references: [id])
  origenRequest    WorkRequest?          @relation("SolicitudAtendida", fields: [origenRequestId], references: [id])
  retomaDe         WorkOrderTask?        @relation("CadenaDeRetoma", fields: [retomaDeTaskId], references: [id])
  retomadaPor      WorkOrderTask?        @relation("CadenaDeRetoma")

  @@index([workOrderId])
  @@index([liberadaAt])
}

model WorkOrderLabor {
  id          String   @id @default(cuid())
  workOrderId String
  userId      String
  hours       Float
  rate        Float    @default(0)
  cost        Float    @default(0)
  workedAt    DateTime @default(now())
  notes       String?

  /// A que actividad se le carga este gasto.
  ///
  /// Opcional a proposito: hay gastos que son de la orden entera —el viaje, la
  /// grua, una refaccion que sirvio para dos cosas— y forzarlos a una actividad
  /// seria inventar. Los que si se pueden atribuir permiten saber cuanto costo
  /// cada falla, que es lo que el Pareto necesita para ordenar por dinero y no
  /// solo por frecuencia.
  taskId    String?
  task      WorkOrderTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  workOrder WorkOrder      @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id])

  @@index([workOrderId])
  @@index([taskId])
  @@index([userId, workedAt])
}

model WorkOrderPart {
  id          String @id @default(cuid())
  workOrderId String
  partId      String
  quantity    Float
  unitCost    Float  @default(0)
  cost        Float  @default(0)

  /// Lo que se regreso al almacen de este cargo. El renglon NO se borra: la
  /// cantidad original se conserva y el costo de la orden se calcula sobre lo
  /// que de verdad se consumio (quantity - devuelto). Sin esto, devolver
  /// material dejaba a la orden pagando lo que nunca uso.
  devuelto Float @default(0)

  /// A que actividad se le carga este gasto.
  ///
  /// Opcional a proposito: hay gastos que son de la orden entera —el viaje, la
  /// grua, una refaccion que sirvio para dos cosas— y forzarlos a una actividad
  /// seria inventar. Los que si se pueden atribuir permiten saber cuanto costo
  /// cada falla, que es lo que el Pareto necesita para ordenar por dinero y no
  /// solo por frecuencia.
  taskId    String?
  task      WorkOrderTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  workOrder WorkOrder      @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  part      Part           @relation(fields: [partId], references: [id])

  @@index([workOrderId])
  @@index([taskId])
}

/// Servicio externo realmente contratado para una orden de trabajo.
/// Se guarda la descripcion ademas del catalogo: un servicio puntual puede no
/// estar catalogado y aun asi debe poder costearse.
model WorkOrderService {
  id             String   @id @default(cuid())
  workOrderId    String
  serviceId      String?
  supplierId     String?
  descripcion    String
  quantity       Float    @default(1)
  unitCost       Float    @default(0)
  cost           Float    @default(0)
  folioProveedor String?
  nota           String?
  createdAt      DateTime @default(now())

  /// A que actividad se le carga este gasto.
  ///
  /// Opcional a proposito: hay gastos que son de la orden entera —el viaje, la
  /// grua, una refaccion que sirvio para dos cosas— y forzarlos a una actividad
  /// seria inventar. Los que si se pueden atribuir permiten saber cuanto costo
  /// cada falla, que es lo que el Pareto necesita para ordenar por dinero y no
  /// solo por frecuencia.
  taskId    String?
  task      WorkOrderTask?   @relation(fields: [taskId], references: [id], onDelete: SetNull)
  workOrder WorkOrder        @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  service   ExternalService? @relation(fields: [serviceId], references: [id])
  supplier  Supplier?        @relation(fields: [supplierId], references: [id])

  @@index([workOrderId])
  @@index([taskId])
}

model WorkOrderComment {
  id          String   @id @default(cuid())
  workOrderId String
  userId      String
  body        String
  createdAt   DateTime @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])

  @@index([workOrderId])
}

/// La conversacion, pegada al registro del que se habla.
///
/// ── Por que existe ──
///
/// Rafael: «se dan muchas interacciones por muchos canales y la mayoria es
/// informacion valiosa que se dispersa». El tecnico pregunta por WhatsApp si
/// la bomba lleva sello 6205 o 6206, alguien contesta, y en veinte minutos esa
/// respuesta no la encuentra nadie —y al mes siguiente se vuelve a preguntar—.
///
/// Aqui la misma pregunta queda amarrada a la orden y al activo para siempre.
/// Ese es todo el punto: no tener chat, sino que lo que se dice viva donde
/// vive el trabajo del que se habla.
///
/// ── Por que una llave por tipo y no `entidad` + `entidadId` ──
///
/// Es el patron de `Attachment`, y por la misma razon: con llaves de verdad el
/// comentario se borra con su registro. Un identificador suelto deja
/// conversaciones huerfanas de ordenes que ya no existen, y nadie las va a ir
/// a limpiar.
/// Quien pidio enterarse de lo que pase con un registro.
///
/// «Avisame lo que pase con esta orden», sin ser el responsable ni el
/// solicitante. Hoy eso se resuelve pidiendole a alguien «me avisas», que es
/// justo el compromiso que se queda en el aire.
///
/// ── Por que `entidad` + `entidadId` y no llaves de verdad ──
///
/// Al reves que en `Comentario`. Aqui la forma la manda `emitirAviso`, que es
/// donde se resuelve a quien se avisa y que trabaja con esas dos cadenas para
/// CUALQUIER tipo de registro —orden, compra, medidor, sensor—. Con llaves por
/// tipo habria que tocar el emisor cada vez que se quiera observar algo nuevo,
/// y observar se vuelve util justamente cuando sirve para todo.
///
/// El precio es que un registro borrado deja su observador colgando. No hace
/// daño —nunca vuelve a coincidir— y se limpia al soltar la organizacion.
model Observador {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  /// Como la nombra `emitirAviso`: WorkOrder, WorkRequest, PurchaseRequest...
  entidad        String
  entidadId      String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entidad, entidadId])
  @@index([organizationId, entidad, entidadId])
}

/// Lo que alguien se comprometio a hacer y no cabe en una orden de trabajo.
///
/// ── Por que no es una orden ──
///
/// «Cotiza el motor con tres proveedores», «habla con seguridad por el
/// permiso», «manda el reporte al corporativo». No tienen activo, ni falla, ni
/// refacciones, ni cierre tecnico: meterlos como orden ensuciaria los
/// indicadores de mantenimiento con trabajo que no lo es.
///
/// ── Y por que NO es una segunda lista de pendientes ──
///
/// Una orden de trabajo YA es una tarea con responsable, fecha y avance. Esto
/// es a proposito lo mas chico posible —un texto, un responsable, una fecha y
/// tres estados— y nace SIEMPRE colgado de un registro. Un compromiso suelto
/// se pierde igual que el mensaje que venia a sustituir.
///
/// ── Por que `entidad` + `entidadId` y no llaves por tipo ──
///
/// Al reves que `Comentario`, y a peticion de Rafael: «los compromisos puedes
/// ponerlos en mas lugares porque es donde se da el momento». Con una llave
/// por tipo, cada lugar nuevo seria una columna y una migracion; asi es un
/// renglon en `lib/anclas.ts` y nada mas.
///
/// El precio es que no hay borrado en cascada. Se paga a proposito: un
/// compromiso es un acuerdo entre personas, y si el registro donde nacio
/// desaparece, lo que acordaron sigue existiendo. La pantalla dice que el
/// registro ya no esta en vez de esconder el compromiso.
model Compromiso {
  id             String    @id @default(cuid())
  organizationId String
  texto          String
  responsableId  String?
  creadoPorId    String?
  /// ABIERTO | HECHO | CANCELADO
  estado         String    @default("ABIERTO")
  paraCuando     DateTime?
  cerradoEl      DateTime?
  createdAt      DateTime  @default(now())

  /// De donde salio. Como la nombra `emitirAviso`: WorkOrder, Asset,
  /// PurchaseRequest... La lista de las que valen esta en `lib/anclas.ts`.
  entidad   String
  entidadId String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  responsable  User?        @relation("CompromisoResponsable", fields: [responsableId], references: [id])
  creadoPor    User?        @relation("CompromisoAutor", fields: [creadoPorId], references: [id])

  @@index([organizationId, entidad, entidadId])
  @@index([organizationId, estado])
  @@index([responsableId, estado])
}

/// Un documento con fecha de vencimiento, colgado de lo que cubre.
///
/// ── Por que es UNO y no siete ──
///
/// Garantia, poliza de seguro, fianza, contrato de servicio, calibracion,
/// permiso de operacion, licencia y certificado son el mismo objeto: un papel
/// con vigencia, colgado de algo, que tiene que avisar antes de vencerse y
/// aparecer en el expediente de lo que cuelga. Siete modelos habrian sido la
/// misma estructura siete veces, con siete pantallas que se desincronizan.
/// Lo que cambia entre ellos es el nombre y a quien se le reclama, y eso es
/// un campo.
///
/// ── De que cuelga ──
///
/// Exactamente UNA de assetId / partId / userId / serviceId, como en
/// `Attachment`. No es un modelo generico con entidad+entidadId porque estas
/// se consultan al abrir un equipo y al revisar que vence este mes: hacen
/// falta las llaves de verdad y el indice.
model Vigencia {
  id             String    @id @default(cuid())
  organizationId String
  /// Del catalogo de `lib/vigencias-tipos.ts`: GARANTIA, POLIZA_SEGURO,
  /// FIANZA, CONTRATO_SERVICIO, CALIBRACION, PERMISO, LICENCIA, CERTIFICADO,
  /// OTRO. Sin enum nativo: el esquema tiene que servir en SQLite y Postgres.
  tipo           String
  /// Como la llama la gente: «Garantia de fabrica», «Poliza GNP 44812».
  titulo         String
  /// Folio del documento: numero de poliza, de contrato, de certificado.
  folio          String?
  desde          DateTime?
  /// Nulo cuando no caduca. Una vigencia sin `hasta` no avisa nunca, y esta
  /// bien: un certificado de fabrica no se renueva.
  hasta          DateTime?
  /// Cuantos dias antes avisar. Nulo toma el del tipo: una poliza se renueva
  /// con mas anticipacion que una calibracion.
  avisarDias     Int?
  /// Que cubre y que no. Es lo que alguien necesita leer cuando llega la
  /// falla, y por eso no es la nota: es su propio campo.
  cubre          String?
  /// A quien se le reclama: el proveedor, la aseguradora, el laboratorio.
  supplierId     String?

  /// De que cuelga. Exactamente uno; lo cuida `lib/vigencias.ts`.
  assetId   String?
  partId    String?
  userId    String?
  serviceId String?

  /// Apagada sin borrarla: una poliza que se cancelo antes de vencer sigue
  /// siendo historia, y borrarla dejaria sin explicacion los avisos que ya
  /// salieron.
  activa      Boolean   @default(true)
  canceladaEl DateTime?
  nota        String?
  creadoPorId String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier     Supplier?        @relation(fields: [supplierId], references: [id])
  asset        Asset?           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  part         Part?            @relation(fields: [partId], references: [id], onDelete: Cascade)
  user         User?            @relation("VigenciaDeUsuario", fields: [userId], references: [id], onDelete: Cascade)
  service      ExternalService? @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  creadoPor    User?            @relation("VigenciaAutor", fields: [creadoPorId], references: [id])

  @@index([organizationId, tipo])
  @@index([organizationId, hasta])
  @@index([assetId])
  @@index([supplierId])
}

/// El eje CONTABLE de la operacion, que es el que mantenimiento no tenia.
///
/// Un activo se agrupa por sitio, ubicacion y categoria: donde esta y que es.
/// Ninguno de los tres es el idioma con el que la empresa lleva su
/// contabilidad, y por eso el costo de mantenimiento —que el sistema calcula
/// bien— no podia entrar a una junta de presupuesto sin que alguien lo
/// tradujera a mano en un Excel.
///
/// No se inventa aqui: se importa del ERP del cliente, como los demas
/// catalogos. Un catalogo de centros de costo cambia dos veces al año, asi que
/// un archivo al año es la solucion correcta y no una limitacion.
model CentroDeCosto {
  id             String   @id @default(cuid())
  organizationId String
  /// La clave tal como la usa su contabilidad. Es la llave para conciliar.
  code           String
  name           String
  descripcion    String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assets       Asset[]
  workOrders   WorkOrder[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

/// Las pantallas que alguien quiere a la mano, arriba de su menu.
///
/// ── Por que personales y no de la empresa ──
///
/// El menu llego a 33 pantallas, y cada quien usa una cuarta parte. Pero no la
/// MISMA cuarta parte: el almacenista vive en existencias y requisiciones, y el
/// director en indicadores y reportes. Un menu que el administrador configura
/// para todos no resuelve ni la mitad del problema, porque no hay un acomodo
/// que le sirva a los dos.
///
/// ── Por que en la base y no en el navegador ──
///
/// Un favorito tiene que seguir a la persona del telefono de piso a la
/// computadora de la oficina. `localStorage` se queda en el aparato, y ahi
/// dejaria de ser suyo para ser de esa maquina.
///
/// ── Lo que NO se guarda aqui ──
///
/// El nombre ni el grupo. La ruta apunta a `lib/pantallas.ts`, que sigue
/// mandando en como se llaman las cosas: asi el soporte, la ayuda y los
/// comandos de voz hablan del mismo sistema que la persona ve en pantalla.
model PantallaFavorita {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  /// La ruta, tal como la registra `lib/pantallas.ts`.
  ruta           String
  /// En que orden las quiere. Se reacomoda al mover una.
  posicion       Int      @default(0)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ruta])
  @@index([userId, posicion])
}

model Comentario {
  id             String    @id @default(cuid())
  organizationId String
  autorId        String?
  texto          String
  /// Un comentario borrado se marca, no se quita: una conversacion con huecos
  /// no se entiende, y el hueco tapa justo lo que alguien quiso tapar.
  eliminadoEl    DateTime?
  editadoEl      DateTime?
  createdAt      DateTime  @default(now())

  workOrderId       String?
  assetId           String?
  workRequestId     String?
  materialRequestId String?

  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  autor           User?               @relation(fields: [autorId], references: [id])
  workOrder       WorkOrder?          @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  asset           Asset?              @relation(fields: [assetId], references: [id], onDelete: Cascade)
  workRequest     WorkRequest?        @relation(fields: [workRequestId], references: [id], onDelete: Cascade)
  materialRequest MaterialRequest?    @relation(fields: [materialRequestId], references: [id], onDelete: Cascade)
  menciones       ComentarioMencion[]

  @@index([organizationId])
  @@index([workOrderId])
  @@index([assetId])
  @@index([workRequestId])
  @@index([materialRequestId])
}

/// A quien se nombro en un comentario.
///
/// Se guarda en vez de sacarse del texto al momento de leerlo. Buscar «@Ana»
/// dentro de la cadena funciona hasta que hay dos Anas, o alguien se llama
/// «Ana Maria», o se cambia un nombre en Usuarios. Ademas hace falta para
/// contestar «que menciones tengo» sin leer todos los comentarios del sistema.
model ComentarioMencion {
  id           String @id @default(cuid())
  comentarioId String
  userId       String

  comentario Comentario @relation(fields: [comentarioId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([comentarioId, userId])
  @@index([userId])
}

model Attachment {
  id             String   @id @default(cuid())
  organizationId String
  workOrderId    String?
  assetId        String?
  workRequestId  String?
  partId         String?
  assetIntakeId  String?
  rondinParadaId String?
  uploadedById   String?
  name           String
  /// Ruta dentro del almacen (no una URL): el enlace de descarga se firma al
  /// momento y caduca. Guardar una URL fija haria publico el archivo.
  storagePath    String
  mimeType       String?
  /// PHOTO | VIDEO | DOCUMENT — para decidir como mostrarlo sin adivinar.
  kind           String   @default("DOCUMENT")
  size           Int      @default(0)
  note           String?
  createdAt      DateTime @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workOrder    WorkOrder?    @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  asset        Asset?        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  workRequest  WorkRequest?  @relation(fields: [workRequestId], references: [id], onDelete: Cascade)
  part         Part?         @relation(fields: [partId], references: [id], onDelete: Cascade)
  rondinParada RondinParada? @relation(fields: [rondinParadaId], references: [id], onDelete: Cascade)
  assetIntake  AssetIntake?  @relation(fields: [assetIntakeId], references: [id], onDelete: Cascade)
  uploadedBy   User?         @relation(fields: [uploadedById], references: [id])

  @@index([organizationId])
  @@index([workOrderId])
  @@index([assetId])
  @@index([workRequestId])
  @@index([partId])
  @@index([assetIntakeId])
}

// ------------------------------------------------------------------ Solicitudes ---

model WorkRequest {
  id              String  @id @default(cuid())
  organizationId  String
  number          String
  title           String
  description     String?
  assetId         String?
  siteId          String?
  locationId      String?
  priority        String  @default("MEDIUM")
  status          String  @default("PENDING") // PENDING|APPROVED|REJECTED|CONVERTED
  requestedById   String?
  /// Punto de reporte del que salio, cuando entro por el portal publico.
  reportPointId   String?
  /// Quien reporto sin ser usuario del sistema. Obligatorios en el portal: una
  /// solicitud anonima es una que nadie puede aclarar por telefono.
  reporterNombre  String?
  reporterCelular String?
  reporterCorreo  String?
  /// Liga de seguimiento. Solo revela ESTA solicitud y no permite listar otras.
  publicToken     String? @unique

  // ── Triage ──────────────────────────────────────────────────────────────
  /// Riesgo detectado al recibir, por patrones en el texto. NINGUNO | ALTO.
  ///
  /// Se calcula en codigo y sin IA a proposito: tiene que ser instantaneo. Un
  /// "huele a gas" no puede esperar a que alguien abra la bandeja, y el
  /// reportante tampoco puede esperar a un modelo con el dedo en Enviar.
  /// Que clase de solicitud es: FALLA | MEJORA | APOYO | OTRO.
  ///
  /// La pone QUIEN REVISA, no quien reporta. Un operador de piso no distingue
  /// una mejora de un apoyo, y ponerle ese menu enfrente produce basura o hace
  /// que no reporte. Al reportante se le pregunta lo que si sabe: que pasa y
  /// que tan urgente lo siente.
  ///
  /// Nula mientras nadie la ha revisado. De aqui sale el tipo de mantenimiento
  /// de la actividad al convertirla, y por lo tanto si cuenta como falla.
  tipo          String?
  riesgo        String    @default("NINGUNO")
  riesgoMotivo  String?
  /// Lo que propuso la IA al abrir la bandeja. Se guarda para no volver a
  /// pagarlo cada vez que alguien mire la misma solicitud.
  iaTitulo      String?
  iaPrioridad   String?
  iaTipo        String?
  iaResumen     String?
  iaDuplicadoDe String?
  iaEl          DateTime?
  reviewedById  String?
  reviewNotes   String?
  /// La OT donde se esta atendiendo. Sin @unique a proposito: una orden
  /// mezclada puede atender varios reportes de falla a la vez, cada uno como
  /// su propia actividad. El detalle de que actividad atiende que reporte
  /// vive en WorkOrderTask.origenRequestId.
  workOrderId   String?
  createdAt     DateTime  @default(now())
  reviewedAt    DateTime?

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  asset           Asset?           @relation(fields: [assetId], references: [id])
  site            Site?            @relation(fields: [siteId], references: [id])
  location        Location?        @relation(fields: [locationId], references: [id])
  requestedBy     User?            @relation("RequestAuthor", fields: [requestedById], references: [id])
  reportPoint     ReportPoint?     @relation(fields: [reportPointId], references: [id])
  rondinHallazgos RondinHallazgo[]
  attachments     Attachment[]
  reviewedBy      User?            @relation("RequestReviewer", fields: [reviewedById], references: [id])
  workOrder       WorkOrder?       @relation(fields: [workOrderId], references: [id])
  actividades     WorkOrderTask[]  @relation("SolicitudAtendida")
  comentarios     Comentario[]

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, tipo])
}

// -------------------------------------------------------------------- Almacen ---

model Supplier {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  /// Registro Federal de Contribuyentes. Opcional —no todo proveedor factura—,
  /// pero cuando existe es la mejor forma de saber que dos proveedores con
  /// nombre distinto son el mismo.
  rfc            String?
  contactName    String?
  email          String?
  phone          String?
  address        String?
  leadTimeDays   Int      @default(7)
  notes          String?
  createdAt      DateTime @default(now())

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parts             Part[]
  services          ExternalService[]
  compras           PurchaseRequest[]
  vigencias         Vigencia[]
  recepciones       GoodsReceipt[]
  cotizaciones      Quote[]
  ordenes           PurchaseOrder[]
  workOrderServices WorkOrderService[]

  @@index([organizationId])
}

model Part {
  id             String   @id @default(cuid())
  organizationId String
  supplierId     String?
  code           String
  name           String
  description    String?
  category       String?
  unit           String   @default("pza")
  unitCost       Float    @default(0)
  /// Suma de la existencia en todos los almacenes.
  ///
  /// Es un valor derivado, no la verdad: la verdad vive en PartStock, uno por
  /// almacen. Se mantiene al dia desde un solo lugar —aplicarMovimiento en
  /// lib/almacen.ts— porque el tablero, el buscador, la exportacion y las
  /// funciones de IA preguntan cuanto hay en total y no tienen por que sumar
  /// almacenes cada vez.
  quantityOnHand Float    @default(0)
  /// Minimo y maximo de referencia. Cada almacen puede tener los suyos; cuando
  /// no los define, hereda estos.
  minQuantity    Float    @default(0)
  maxQuantity    Float    @default(0)
  /// Ubicacion por omision. La real vive en PartStock, por almacen.
  bin            String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization     Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier         Supplier?               @relation(fields: [supplierId], references: [id])
  movements        StockMovement[]
  existencias      PartStock[]
  traspasos        StockTransferLine[]
  requisiciones    MaterialRequestLine[]
  compras          PurchaseRequestLine[]
  recibidas        GoodsReceiptLine[]
  cotizadas        QuoteLine[]
  conteos          InventoryCountLine[]
  planTaskParts    PlanTaskPart[]
  usedIn           WorkOrderPart[]
  attachments      Attachment[]
  vigencias        Vigencia[]
  links            ReferenceLink[]
  tareasBloqueadas WorkOrderTask[]
  equivalenciasA   EquivalenciaRefaccion[] @relation("EquivalenciaA")
  equivalenciasB   EquivalenciaRefaccion[] @relation("EquivalenciaB")

  @@unique([organizationId, code])
  @@index([organizationId])
}

model StockMovement {
  id                String   @id @default(cuid())
  organizationId    String
  partId            String
  warehouseId       String?
  workOrderId       String?
  transferId        String?
  materialRequestId String?
  /// La recepcion de compra que origino la entrada. Sin esto el kardex mostraba
  /// «—» en el documento y la entrada quedaba huerfana: la compra conservaba
  /// todo y el almacen no podia volver a ella.
  goodsReceiptId    String?
  userId            String?
  /// A quien se le entrego fisicamente. Puede no ser quien pidio —un ayudante
  /// pasa por el material— y por eso no basta con el solicitante de la
  /// requisicion. Es texto libre porque el que recoge no siempre es usuario.
  entregadoA        String?
  /// Por que entro o se ajusto, del catalogo de `lib/motivos-movimiento.ts`.
  ///
  /// Va aparte de `reference` porque con texto libre no se puede agrupar, y la
  /// pregunta que hay que poder contestar es «cuanto material entro sin venir
  /// de una compra, y por que». `reference` sigue guardando el detalle que
  /// ningun catalogo captura —cual proyecto, cual obra—.
  ///
  /// Opcional porque los movimientos anteriores a esto no lo tienen, y porque
  /// las salidas y los traspasos no lo piden: ya traen su documento.
  motivo            String?
  /// IN | OUT | ADJUST | RETURN | TRANSFER_IN | TRANSFER_OUT
  ///
  /// RETURN es la devolucion de lo que el tecnico pidio y no uso. Se separa de
  /// IN a proposito: una devolucion no es una compra, y mezclarlas inflaria el
  /// consumo aparente del almacen.
  movementType      String
  quantity          Float
  unitCost          Float    @default(0)
  balanceAfter      Float    @default(0)
  reference         String?
  createdAt         DateTime @default(now())

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  part            Part             @relation(fields: [partId], references: [id], onDelete: Cascade)
  warehouse       Warehouse?       @relation(fields: [warehouseId], references: [id])
  workOrder       WorkOrder?       @relation(fields: [workOrderId], references: [id])
  transfer        StockTransfer?   @relation(fields: [transferId], references: [id], onDelete: Cascade)
  materialRequest MaterialRequest? @relation(fields: [materialRequestId], references: [id])
  goodsReceipt    GoodsReceipt?    @relation(fields: [goodsReceiptId], references: [id])
  user            User?            @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([partId])
  @@index([warehouseId])
  @@index([organizationId, createdAt])
  @@index([partId, createdAt])
}

/// Un almacen fisico. La mayoria de las empresas tiene uno general y varios
/// subalmacenes por planta o por linea.
model Warehouse {
  id             String   @id @default(cuid())
  organizationId String
  siteId         String?
  code           String
  name           String
  responsableId  String?
  /// El que recibe la existencia al migrar y el destino por omision de una
  /// compra. Solo uno por organizacion.
  esGeneral      Boolean  @default(false)
  active         Boolean  @default(true)
  notas          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site          Site?             @relation(fields: [siteId], references: [id])
  responsable   User?             @relation(fields: [responsableId], references: [id])
  existencias   PartStock[]
  movements     StockMovement[]
  salidas       StockTransfer[]   @relation("TraspasoOrigen")
  entradas      StockTransfer[]   @relation("TraspasoDestino")
  requisiciones MaterialRequest[]
  compras       PurchaseRequest[]
  recepciones   GoodsReceipt[]
  ordenes       PurchaseOrder[]
  conteos       InventoryCount[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

/// La existencia de una refaccion en un almacen. Aqui vive la verdad del saldo.
model PartStock {
  id             String   @id @default(cuid())
  organizationId String
  partId         String
  warehouseId    String
  quantity       Float    @default(0)
  /// Nulo significa heredar el de la refaccion. El almacen general y el de
  /// linea rara vez tienen el mismo minimo.
  minQuantity    Float?
  maxQuantity    Float?
  /// Donde esta dentro de este almacen. Formato libre, sugerido P3-R2-N4.
  bin            String?
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  part         Part         @relation(fields: [partId], references: [id], onDelete: Cascade)
  warehouse    Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([partId, warehouseId])
  @@index([organizationId])
  @@index([warehouseId])
}

/// Traspaso entre almacenes: un documento que produce dos movimientos por
/// renglon, la salida del origen y la entrada al destino.
/// Requisicion de compra: lo que el almacen no tuvo y hay que adquirir.
///
/// Nace casi siempre de una requisicion de material que no se pudo surtir. El
/// campo ocExterna es lo que hace opcional el proceso de compras: cuando la
/// empresa compra en su propio ERP, aqui se anota el folio de esa orden y el
/// documento salta directo a recepcion sin perder el rastro.
model PurchaseRequest {
  id                  String    @id @default(cuid())
  organizationId      String
  folio               String
  warehouseId         String
  materialRequestId   String?
  solicitanteId       String?
  proveedorSugeridoId String?
  /// NORMAL | ALTA | PARO
  urgencia            String    @default("NORMAL")
  justificacion       String?
  montoEstimado       Float     @default(0)
  /// Folio de la orden de compra, sea la interna o la del ERP del cliente.
  ordenCompra         String?
  /// SOLICITADA | AUTORIZADA | RECHAZADA | EN_COMPRA | RECIBIDA_PARCIAL | RECIBIDA | CERRADA | CANCELADA
  estado              String    @default("SOLICITADA")
  autorizadaPorId     String?
  autorizadaEl        DateTime?
  motivoRechazo       String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  organization      Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouse         Warehouse             @relation(fields: [warehouseId], references: [id])
  materialRequest   MaterialRequest?      @relation(fields: [materialRequestId], references: [id])
  solicitante       User?                 @relation("CompraSolicitante", fields: [solicitanteId], references: [id])
  autorizadaPor     User?                 @relation("CompraAutorizador", fields: [autorizadaPorId], references: [id])
  proveedorSugerido Supplier?             @relation(fields: [proveedorSugeridoId], references: [id])
  renglones         PurchaseRequestLine[]
  recepciones       GoodsReceipt[]
  cotizaciones      Quote[]
  ordenes           PurchaseOrder[]

  @@unique([organizationId, folio])
  @@index([organizationId])
  @@index([estado])
}

model PurchaseRequestLine {
  id                    String  @id @default(cuid())
  requestId             String
  /// El renglon de la requisicion de material que quedo faltante y origino
  /// esta compra. Es lo que permite seguir la pista completa —OT, activo,
  /// requisicion, renglon, parte— y no volver a comprar lo mismo dos veces.
  materialRequestLineId String?
  partId                String?
  descripcion           String
  cantidadSolicitada    Float
  cantidadRecibida      Float   @default(0)
  costoEstimado         Float   @default(0)
  nota                  String?

  request             PurchaseRequest      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  part                Part?                @relation(fields: [partId], references: [id])
  materialRequestLine MaterialRequestLine? @relation(fields: [materialRequestLineId], references: [id])

  @@index([requestId])
  @@index([materialRequestLineId])
}

/// Recepcion: lo que llego contra lo que se pidio, con la revision fisica.
///
/// Es un documento aparte de la requisicion porque una compra puede llegar en
/// varias entregas, cada una con su remision, su fecha y su revision. La
/// entrada al inventario la hacen los movimientos que produce.
model GoodsReceipt {
  id                String   @id @default(cuid())
  organizationId    String
  folio             String
  /// Clave que manda la pantalla al recibir. Si el mismo envio llega dos veces
  /// —doble clic, reintento, recargar— la segunda encuentra esta clave y
  /// devuelve la recepcion que ya existe en vez de entrar el material dos
  /// veces al inventario.
  clave             String?
  purchaseRequestId String?
  warehouseId       String
  supplierId        String?
  /// Remision o factura con la que llego la mercancia.
  remision          String?
  ordenCompra       String?
  recibidoPorId     String?
  /// Cuando no hay persona detras: el nombre de la integracion que la
  /// registro. Una recepcion que mando el ERP sin esto se veria sin quien
  /// la recibio, y eso es peor que decir de donde vino. Mismo criterio que
  /// WorkRequest.reporterNombre.
  recibidoPorNombre String?
  nota              String?
  createdAt         DateTime @default(now())

  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseRequest PurchaseRequest?   @relation(fields: [purchaseRequestId], references: [id])
  warehouse       Warehouse          @relation(fields: [warehouseId], references: [id])
  supplier        Supplier?          @relation(fields: [supplierId], references: [id])
  recibidoPor     User?              @relation(fields: [recibidoPorId], references: [id])
  renglones       GoodsReceiptLine[]
  movimientos     StockMovement[]

  @@unique([organizationId, folio])
  @@unique([organizationId, clave])
  @@index([organizationId])
}

model GoodsReceiptLine {
  id            String  @id @default(cuid())
  receiptId     String
  requestLineId String?
  partId        String
  cantidad      Float
  costoUnitario Float   @default(0)
  /// Si paso la revision fisica. Lo que no pasa se recibe igual pero queda
  /// senalado: devolverlo al proveedor es una conversacion, no un borrado.
  conforme      Boolean @default(true)
  observacion   String?

  receipt GoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  part    Part         @relation(fields: [partId], references: [id])

  @@index([receiptId])
}

/// Cotizacion de un proveedor para una requisicion de compra.
///
/// El cuadro comparativo NO es un modelo: es una pantalla que pone estas
/// cotizaciones lado a lado. Guardarlo seria guardar una foto que se
/// desactualiza en cuanto llega una cotizacion mas. Lo unico que hay que
/// conservar es cual gano y por que, y eso vive aqui mismo.
model Quote {
  id                String    @id @default(cuid())
  organizationId    String
  purchaseRequestId String
  supplierId        String
  /// El numero con el que el proveedor identifica su cotizacion.
  folioProveedor    String?
  vigenciaHasta     DateTime?
  diasEntrega       Int?
  condicionesPago   String?
  garantia          String?
  /// Cuando cotizan en otra moneda. El total siempre se guarda ya convertido.
  monedaOriginal    String?
  tipoCambio        Float?
  total             Float     @default(0)
  seleccionada      Boolean   @default(false)
  /// Por que se eligio esta y no la mas barata. Es lo que defiende la decision
  /// cuando alguien la revise en dos años.
  motivoSeleccion   String?
  nota              String?
  capturadaPorId    String?
  createdAt         DateTime  @default(now())

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseRequest PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  supplier        Supplier        @relation(fields: [supplierId], references: [id])
  capturadaPor    User?           @relation(fields: [capturadaPorId], references: [id])
  renglones       QuoteLine[]
  ordenes         PurchaseOrder[]

  @@index([organizationId])
  @@index([purchaseRequestId])
}

model QuoteLine {
  id             String  @id @default(cuid())
  quoteId        String
  requestLineId  String?
  partId         String?
  descripcion    String
  marca          String?
  especificacion String?
  cantidad       Float
  costoUnitario  Float   @default(0)
  /// El proveedor puede no tener uno de los renglones. Se registra igual:
  /// que no lo surta es informacion para el comparativo.
  disponible     Boolean @default(true)

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  part  Part? @relation(fields: [partId], references: [id])

  @@index([quoteId])
}

/// Orden de compra: el compromiso formal con el proveedor.
///
/// No lleva renglones propios a proposito. El QUE lo define la requisicion y
/// el A CUANTO la cotizacion elegida; duplicarlos aqui obligaria a mantener
/// tres copias de la misma lista y la recepcion tendria que decidir contra
/// cual cuadrar.
model PurchaseOrder {
  id                String    @id @default(cuid())
  organizationId    String
  folio             String
  purchaseRequestId String
  quoteId           String?
  supplierId        String
  warehouseId       String
  /// ABIERTA | RECIBIDA_PARCIAL | RECIBIDA | CANCELADA
  estado            String    @default("ABIERTA")
  condicionesPago   String?
  fechaPrometida    DateTime?
  total             Float     @default(0)
  nota              String?
  emitidaPorId      String?
  createdAt         DateTime  @default(now())

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseRequest PurchaseRequest @relation(fields: [purchaseRequestId], references: [id])
  quote           Quote?          @relation(fields: [quoteId], references: [id])
  supplier        Supplier        @relation(fields: [supplierId], references: [id])
  warehouse       Warehouse       @relation(fields: [warehouseId], references: [id])
  emitidaPor      User?           @relation(fields: [emitidaPorId], references: [id])

  @@unique([organizationId, folio])
  @@index([organizationId])
}

/// Conteo ciclico: contar el anaquel y cuadrarlo contra el sistema.
///
/// Al abrirlo se toma una foto de lo que el sistema cree que hay. Esa foto es
/// contra lo que se mide la diferencia; el ajuste, en cambio, se aplica contra
/// lo que haya al momento de cerrar. Si entre una cosa y otra hubo movimientos
/// legitimos, el sistema lo dice en vez de borrarlos en silencio.
model InventoryCount {
  id             String    @id @default(cuid())
  organizationId String
  folio          String
  warehouseId    String
  responsableId  String?
  /// ABIERTO | CERRADO | CANCELADO
  estado         String    @default("ABIERTO")
  /// Que se conto: todo el almacen o una familia. Solo informativo.
  alcance        String?
  nota           String?
  abiertoEl      DateTime  @default(now())
  cerradoEl      DateTime?

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouse    Warehouse            @relation(fields: [warehouseId], references: [id])
  responsable  User?                @relation(fields: [responsableId], references: [id])
  renglones    InventoryCountLine[]

  @@unique([organizationId, folio])
  @@index([organizationId])
}

model InventoryCountLine {
  id               String  @id @default(cuid())
  countId          String
  partId           String
  /// Lo que el sistema decia al ABRIR el conteo.
  cantidadSistema  Float
  /// Lo que se conto en el anaquel. Nulo mientras no se capture.
  cantidadContada  Float?
  /// Lo que habia al momento de cerrar. Si difiere de cantidadSistema es que
  /// hubo movimientos durante el conteo.
  cantidadAlCerrar Float?
  nota             String?

  count InventoryCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  part  Part           @relation(fields: [partId], references: [id])

  @@unique([countId, partId])
  @@index([countId])
}

/// Punto de reporte: el codigo QR que se pega en un lugar o en una maquina.
///
/// Existe como entidad y no como token firmado sobre el activo porque el
/// cliente necesita poder nombrarlos, imprimirlos, revocar uno que se filtro y
/// ver de cual salen mas reportes. Un token derivado no se puede revocar sin
/// invalidar todos.
///
/// Su valor real es el contexto: quien escanea no tiene que saber como se
/// llama el equipo. El QR ya trae el sitio, la ubicacion y muchas veces el
/// activo exacto, y eso convierte "el aire del salon 3 no enfria" en una
/// solicitud accionable sin una llamada de por medio.
model ReportPoint {
  id             String   @id @default(cuid())
  organizationId String
  /// Lo que viaja en la URL del QR. La organizacion sale de aqui, NUNCA de lo
  /// que mande el navegador.
  token          String   @unique
  nombre         String
  siteId         String?
  locationId     String?
  assetId        String?
  activo         Boolean  @default(true)
  nota           String?
  /// Que se le enseña a quien escanea el codigo, que es cualquiera que pase.
  ///
  /// Por omision, lo MINIMO para que el reporte se pueda ubicar: el nombre del
  /// punto y la clave del equipo. El nombre de la empresa, el de la planta y el
  /// del equipo completo se muestran solo si alguien lo decide a proposito. Un
  /// QR pegado en un pasillo lo lee cualquiera; no tiene por que anunciar quien
  /// es el dueño de la instalacion ni como se llama internamente cada area.
  mostrarEmpresa Boolean  @default(false)
  mostrarPlanta  Boolean  @default(false)
  mostrarEquipo  Boolean  @default(false)
  createdById    String?
  createdAt      DateTime @default(now())

  rondinParadas RondinParada[]
  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site          Site?          @relation(fields: [siteId], references: [id])
  location      Location?      @relation(fields: [locationId], references: [id])
  asset         Asset?         @relation(fields: [assetId], references: [id])
  createdBy     User?          @relation(fields: [createdById], references: [id])
  solicitudes   WorkRequest[]

  @@index([organizationId])
}

model StockTransfer {
  id             String   @id @default(cuid())
  organizationId String
  folio          String
  origenId       String
  destinoId      String
  userId         String?
  nota           String?
  createdAt      DateTime @default(now())

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  origen       Warehouse           @relation("TraspasoOrigen", fields: [origenId], references: [id])
  destino      Warehouse           @relation("TraspasoDestino", fields: [destinoId], references: [id])
  user         User?               @relation(fields: [userId], references: [id])
  renglones    StockTransferLine[]
  movements    StockMovement[]

  @@unique([organizationId, folio])
  @@index([organizationId])
}

/// Requisicion de material: mantenimiento le pide al almacen.
///
/// El vale de salida NO es un documento aparte: es el cumplimiento de esta
/// requisicion. Cada entrega parcial queda como movimientos ligados aqui, con
/// su fecha y a quien se le dio. Separarlos obligaria a reconciliar dos
/// documentos para siempre.
model MaterialRequest {
  id             String    @id @default(cuid())
  organizationId String
  folio          String
  warehouseId    String
  /// La OT que lo origina. Sin ella, al menos el activo: una refaccion que
  /// sale sin destino es un costo que despues nadie puede atribuir.
  workOrderId    String?
  assetId        String?
  solicitanteId  String?
  /// PREVENTIVO | CORRECTIVO | MINIMO | PROYECTO
  motivo         String    @default("CORRECTIVO")
  /// NORMAL | ALTA | PARO
  urgencia       String    @default("NORMAL")
  nota           String?
  /// SOLICITADA | PARCIAL | SURTIDA | CERRADA | CANCELADA
  estado         String    @default("SOLICITADA")
  cerradaEl      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouse    Warehouse             @relation(fields: [warehouseId], references: [id])
  workOrder    WorkOrder?            @relation(fields: [workOrderId], references: [id])
  asset        Asset?                @relation(fields: [assetId], references: [id])
  solicitante  User?                 @relation(fields: [solicitanteId], references: [id])
  renglones    MaterialRequestLine[]
  movements    StockMovement[]
  compras      PurchaseRequest[]
  comentarios  Comentario[]

  @@unique([organizationId, folio])
  @@index([organizationId])
  @@index([warehouseId])
  @@index([workOrderId])
}

model MaterialRequestLine {
  id                 String  @id @default(cuid())
  requestId          String
  /// La ACTIVIDAD de la orden que necesita este material.
  ///
  /// Una misma orden puede traer el preventivo del mes y la fuga que se
  /// reporto: el material de cada una es de distinto tipo y no se puede
  /// clasificar por el encabezado. Nulo a proposito cuando el material es de
  /// la orden completa («consumo general») o cuando el vale es historico: ahi
  /// no se inventa una actividad, se muestra como no especificada.
  taskId             String?
  /// Nulo cuando se pide algo que no esta en el catalogo. La descripcion
  /// siempre va: es lo que permite pedir lo que todavia no existe.
  partId             String?
  descripcion        String
  cantidadSolicitada Float
  cantidadSurtida    Float   @default(0)
  cantidadDevuelta   Float   @default(0)
  nota               String?

  request MaterialRequest       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  part    Part?                 @relation(fields: [partId], references: [id])
  task    WorkOrderTask?        @relation(fields: [taskId], references: [id], onDelete: SetNull)
  /// Las compras que se generaron por lo que falto de este renglon.
  compras PurchaseRequestLine[]

  @@index([requestId])
  @@index([taskId])
}

model StockTransferLine {
  id         String @id @default(cuid())
  transferId String
  partId     String
  quantity   Float
  unitCost   Float  @default(0)

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  part     Part          @relation(fields: [partId], references: [id])

  @@index([transferId])
}

// ------------------------------------------------- Enlaces de consulta

/// Referencias externas que complementan un registro: manual del fabricante en
/// linea, ficha del proveedor, video del procedimiento, norma aplicable.
/// Se guarda el enlace, no el contenido: lo que vive afuera se consulta afuera.
model ReferenceLink {
  id             String   @id @default(cuid())
  organizationId String
  assetId        String?
  partId         String?
  planId         String?
  createdById    String?
  title          String
  url            String
  note           String?
  createdAt      DateTime @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  asset        Asset?           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  part         Part?            @relation(fields: [partId], references: [id], onDelete: Cascade)
  plan         MaintenancePlan? @relation(fields: [planId], references: [id], onDelete: Cascade)
  createdBy    User?            @relation(fields: [createdById], references: [id])

  @@index([organizationId])
  @@index([assetId])
  @@index([partId])
  @@index([planId])
}

// -------------------------------------------- Especialidades y servicios

/// Oficio o especialidad del personal de mantenimiento, con su tarifa estandar.
/// En un PLAN no se sabe quien ejecutara: se estima por especialidad. En la OT
/// se registra la persona real y su tarifa propia.
model Specialty {
  id             String   @id @default(cuid())
  organizationId String
  code           String
  name           String
  hourlyRate     Float    @default(0)
  createdAt      DateTime @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planLabor    PlanTaskLabor[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

/// Servicio que se subcontrata a un proveedor para completar un trabajo:
/// rebobinado de motor, balanceo dinamico, analisis de aceite, maniobra con
/// gruas, calibracion certificada. Es el tercer componente del costo, junto a
/// mano de obra propia y refacciones.
model ExternalService {
  id             String   @id @default(cuid())
  organizationId String
  supplierId     String?
  code           String
  name           String
  description    String?
  unit           String   @default("servicio")
  unitCost       Float    @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier     Supplier?          @relation(fields: [supplierId], references: [id])
  planServices PlanTaskService[]
  workOrders   WorkOrderService[]
  vigencias    Vigencia[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

// ------------------------------------ Recursos planeados por actividad

/// Mano de obra propia estimada para una actividad del plan.
model PlanTaskLabor {
  id          String @id @default(cuid())
  planTaskId  String
  specialtyId String
  personas    Int    @default(1)
  hours       Float  @default(1)

  task      PlanTask  @relation(fields: [planTaskId], references: [id], onDelete: Cascade)
  specialty Specialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@index([planTaskId])
}

/// Refacciones estimadas para una actividad del plan.
model PlanTaskPart {
  id         String @id @default(cuid())
  planTaskId String
  partId     String
  quantity   Float  @default(1)

  task PlanTask @relation(fields: [planTaskId], references: [id], onDelete: Cascade)
  part Part     @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@unique([planTaskId, partId])
  @@index([planTaskId])
}

/// Servicios externos estimados para una actividad del plan.
model PlanTaskService {
  id         String  @id @default(cuid())
  planTaskId String
  serviceId  String
  quantity   Float   @default(1)
  nota       String?

  task    PlanTask        @relation(fields: [planTaskId], references: [id], onDelete: Cascade)
  service ExternalService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([planTaskId])
}

// ------------------------------------------------- Catalogos de refacciones

/// Familias de refaccion (rodamientos, filtros, sellos...).
/// Part.category guarda el `code` de este catalogo, validado al guardar.
model PartCategory {
  id             String   @id @default(cuid())
  organizationId String
  code           String
  name           String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@index([organizationId])
}

/// Unidades de medida (pza, lt, kg...). Part.unit guarda el `code`.
model PartUnit {
  id             String   @id @default(cuid())
  organizationId String
  code           String
  name           String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@index([organizationId])
}

// ----------------------------------------------------------------- Predictivo ---

model Sensor {
  id                String    @id @default(cuid())
  organizationId    String
  assetId           String
  name              String
  sensorType        String // VIBRATION|TEMPERATURE|PRESSURE|CURRENT|OIL|ULTRASOUND|FLOW|RPM
  unit              String
  warningThreshold  Float?
  criticalThreshold Float?
  direction         String    @default("ABOVE") // ABOVE | BELOW
  samplingHours     Int       @default(24)
  active            Boolean   @default(true)
  lastValue         Float?
  lastStatus        String    @default("NORMAL")
  lastReadingAt     DateTime?
  createdAt         DateTime  @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  asset        Asset             @relation(fields: [assetId], references: [id], onDelete: Cascade)
  readings     SensorReading[]
  alerts       PredictiveAlert[]

  @@index([organizationId])
  @@index([assetId])
}

model SensorReading {
  id             String   @id @default(cuid())
  organizationId String
  sensorId       String
  value          Float
  status         String   @default("NORMAL") // NORMAL | WARNING | CRITICAL
  readingAt      DateTime @default(now())
  source         String   @default("IOT")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sensor       Sensor       @relation(fields: [sensorId], references: [id], onDelete: Cascade)

  @@index([sensorId])
  @@index([organizationId])
  @@index([sensorId, readingAt])
}

model PredictiveAlert {
  id                 String    @id @default(cuid())
  organizationId     String
  sensorId           String?
  assetId            String
  workOrderId        String?
  severity           String    @default("WARNING") // WARNING | CRITICAL
  title              String
  message            String
  value              Float?
  threshold          Float?
  trendSlope         Float?
  /// Legado: una sola fecha que mezclaba cruce de advertencia y critico y se
  /// mostraba como «falla». Se conserva; ya no se presenta como falla.
  projectedFailureAt DateTime?
  status             String    @default("OPEN") // OPEN | ACKNOWLEDGED | RESOLVED | DISMISSED

  /// ADVERTENCIA | CRITICO | TENDENCIA: la condicion que abrio la alerta. Una
  /// alerta abierta por punto; si la condicion empeora se escala la misma.
  condicion String?

  /// Ultima evaluacion del punto (`lib/predictive.ts` evaluarPunto).
  estadoActual          String? // NORMAL | ADVERTENCIA | CRITICO | SIN_DATOS
  tendencia             String? // EMPEORA | MEJORA | ESTABLE | SIN_DATOS
  confianza             String? // ALTA | MEDIA | BAJA | INSUFICIENTE
  lecturasUsadas        Int?
  fechaCruceAdvertencia DateTime?
  fechaCruceCritico     DateTime?
  evaluadaEl            DateTime?

  /// Cuando el valor regreso a normal. La alerta NO se cierra sola: alguien
  /// valida que la normalizacion es real (no un sensor desconectado).
  normalizadaEl DateTime?

  /// La lectura que mostro la normalizacion: la evidencia con que se valido.
  normalizacionLecturaId String?
  normalizacionValor     Float?
  normalizacionLecturaEl DateTime?

  /// Quien cerro la alerta, cuando y con que nota. Aparte de `acknowledgedBy`
  /// para no perder quien la reconocio.
  resueltaPorId    String?
  resueltaEl       DateTime?
  resolucion       String?
  acknowledgedById String?
  acknowledgedAt   DateTime?
  createdAt        DateTime  @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sensor         Sensor?      @relation(fields: [sensorId], references: [id], onDelete: Cascade)
  asset          Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  workOrder      WorkOrder?   @relation(fields: [workOrderId], references: [id])
  acknowledgedBy User?        @relation(fields: [acknowledgedById], references: [id])

  @@index([organizationId])
  @@index([assetId])
}

// ------------------------------------------------------ Cobranza

/// Cargo mensual por el uso de la plataforma.
///
/// NO es un comprobante fiscal: es la nota de cobro con la que el cliente sabe
/// cuanto debe y de que periodo. La factura fiscal (CFDI) se emite aparte, por
/// los medios que corresponda.
///
/// El importe se congela al emitir: si el cliente cambia de plan a mitad de mes,
/// el cargo ya emitido conserva lo que se cobro, no lo que cuesta hoy.
/// Un consumo de IA: una llamada al modelo, con lo que costo.
///
/// Se guarda por organizacion y por periodo para poder responder dos preguntas
/// distintas sin recalcular nada: cuanto ha gastado la plataforma (en dolares,
/// que es como se factura el modelo) y cuantas operaciones lleva el cliente
/// contra las que incluye su plan.
model AiUsage {
  id               String   @id @default(cuid())
  organizationId   String
  userId           String?
  /// Clave de lib/ia/funciones.ts: DIAGNOSTICO, CIERRE_OT, PLAN…
  funcion          String
  modelo           String
  inputTokens      Int      @default(0)
  outputTokens     Int      @default(0)
  cacheReadTokens  Int      @default(0)
  cacheWriteTokens Int      @default(0)
  /// Lo que se le descuenta al cliente de su bolsa mensual.
  operaciones      Int      @default(1)
  /// Costo real ante Anthropic, en USD.
  costoUsd         Float    @default(0)
  /// AAAA-MM, para agrupar sin convertir fechas.
  periodo          String
  ok               Boolean  @default(true)
  error            String?
  createdAt        DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])

  @@index([organizationId, periodo])
  @@index([createdAt])
}

/// El diagnostico que la IA genera cada semana para una organizacion.
/// Resultado de «Revisar la semana», guardado al generarse.
///
/// Si la respuesta no llega a la pantalla —se cae la red, se agota el tiempo,
/// se cierra la pestaña— la operacion ya se cobro. Guardarla permite entregar
/// ese mismo resultado al volver a intentar, sin volver a llamar al modelo ni
/// descontar operaciones, mientras los datos de la semana no hayan cambiado
/// (la `huella` es el hash exacto de lo que se le envio al modelo).
model RevisionAgenda {
  id              String   @id @default(cuid())
  organizationId  String
  userId          String?
  /// Lunes de la semana revisada, aaaa-mm-dd.
  semana          String
  huella          String
  /// La revision validada, serializada.
  contenido       String
  costoUsd        Float    @default(0)
  /// Cuantas veces se entrego sin volver a generarla.
  reutilizaciones Int      @default(0)
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, semana, huella])
}

model AiReport {
  id             String   @id @default(cuid())
  organizationId String
  desde          DateTime
  hasta          DateTime
  /// Resumen ejecutivo en una o dos frases.
  resumen        String
  /// El reporte completo, serializado. Se guarda como texto y no como Json
  /// nativo para que el esquema siga corriendo igual en SQLite y PostgreSQL.
  contenido      String
  /// Indice de salud de datos al momento de generarlo, de 0 a 100.
  saludDatos     Float    @default(0)
  modelo         String
  costoUsd       Float    @default(0)
  /// AUTOMATICO | MANUAL
  origen         String   @default("AUTOMATICO")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

/// Una sesion de levantamiento de inventario asistido.
///
/// El borrador vive aparte de los activos reales a proposito: se revisa, se
/// corrige y se verifica en piso ANTES de que exista un solo activo. Un
/// inventario mal levantado ensucia el sistema para siempre, y deshacerlo
/// cuesta mas que levantarlo bien.
model AssetIntake {
  id             String    @id @default(cuid())
  organizationId String
  createdById    String?
  /// Como describio el usuario la instalacion.
  descripcion    String
  /// Tipo de instalacion detectado: EDIFICIO, GIMNASIO, ESCUELA, HOSPITAL…
  tipo           String?
  /// Preguntas y respuestas de la entrevista, serializadas.
  entrevista     String    @default("[]")
  /// BORRADOR | REVISADO | APLICADO
  estado         String    @default("BORRADOR")
  notaIa         String?
  createdAt      DateTime  @default(now())
  aplicadoEl     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdById], references: [id])
  propuestas   AssetDraft[]
  // Las fotos del recorrido: la evidencia de que lo propuesto se vio y no se
  // supuso. Un adjunto de este tipo sin levantamiento es una foto que se
  // analizo y cuyo borrador nunca se llego a crear.
  adjuntos     Attachment[]

  @@index([organizationId])
}

/// Un activo propuesto, todavia sin existir.
model AssetDraft {
  id           String  @id @default(cuid())
  intakeId     String
  /// Sistema o area al que pertenece: climatizacion, electrico, cocina…
  sistema      String
  nombre       String
  categoria    String?
  criticidad   String  @default("C")
  ubicacion    String?
  /// Cuantos equipos iguales. Al aplicar se crea uno por cada uno.
  cantidad     Int     @default(1)
  /// Por que se propone: que funcion cumple y que pasa si falla.
  porQue       String?
  /// Datos de placa. Nacen vacios y se llenan en piso: nunca se inventan.
  fabricante   String?
  modelo       String?
  /// PENDIENTE | ACEPTADO | DESCARTADO | APLICADO
  estado       String  @default("PENDIENTE")
  /// Codigo con el que se creo, cuando ya se aplico.
  codigoCreado String?

  intake AssetIntake @relation(fields: [intakeId], references: [id], onDelete: Cascade)

  @@index([intakeId])
}

model Invoice {
  id             String    @id @default(cuid())
  organizationId String
  folio          String
  /// Periodo cubierto, en formato AAAA-MM
  periodo        String
  concepto       String
  plan           String
  importe        Float
  /// Parte del importe que corresponde al complemento de IA.
  importeIa      Float     @default(0)
  moneda         String    @default("MXN")
  /// PENDING | PAID | CANCELLED
  status         String    @default("PENDING")
  emitidaEl      DateTime  @default(now())
  venceEl        DateTime
  pagadaEl       DateTime?
  formaPago      String?
  referenciaPago String?
  nota           String?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, periodo])
  @@unique([organizationId, folio])
  @@index([organizationId])
  @@index([status])
}

// ------------------------------------------------ Cambios de plan

/// Solicitud de cambio de plan hecha por el cliente.
///
/// Con cobro manual el cliente no puede cambiarse solo: pide el cambio, queda
/// en cola para el operador de la plataforma, y este lo aplica cuando el pago
/// esta acordado. Deja constancia de quien pidio que y cuando.
model PlanRequest {
  id             String    @id @default(cuid())
  organizationId String
  requestedById  String?
  planActual     String
  planSolicitado String
  /// PENDING | APPLIED | DISMISSED
  status         String    @default("PENDING")
  nota           String?
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedBy  User?        @relation(fields: [requestedById], references: [id])

  @@index([organizationId])
  @@index([status])
}

// ------------------------------------------------ Comercial (Bloque 7)

/// Quien pidio una demostracion o quiso contratar desde el sitio.
///
/// Es de la plataforma, no de una empresa cliente: no lleva organizationId de
/// dueño y solo lo ve el operador. No es un CRM: registra lo minimo para dar
/// seguimiento y saber por que se gana o se pierde.
model Prospecto {
  id              String    @id @default(cuid())
  /// DEMO | CONTRATACION
  tipo            String    @default("DEMO")
  nombre          String
  empresa         String
  correo          String
  telefono        String?
  tipoInstalacion String?
  /// "1-50" | "51-200" | "201-1000" | "1000+"
  rangoActivos    String?
  problema        String?
  planInteres     String?
  /// De donde llego: SITIO | CONTRATAR | la fuente que traiga la liga (?origen=)
  origen          String    @default("SITIO")
  /// NUEVA | CONTACTADA | DEMO_AGENDADA | DEMO_REALIZADA | PROPUESTA | GANADA | PERDIDA | DESCARTADA
  estado          String    @default("NUEVA")
  demoRealizadaAt DateTime?
  resultado       String?
  motivoPerdida   String?
  notas           String?
  /// Version del aviso de privacidad que acepto.
  avisoPrivacidad String
  /// Tipo + correo normalizado + dia: la misma persona dos veces el mismo dia es un duplicado.
  huella          String    @unique
  /// La empresa que se creo, si contrato.
  organizationId  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([estado])
  @@index([createdAt])
}

/// Una solicitud de ayuda al equipo de MainTrack, hecha desde el producto.
///
/// Es el unico canal de soporte (Bloque 7): no se publican correos ni
/// telefonos. El folio es por empresa (spSequence).
model SolicitudSoporte {
  id                 String    @id @default(cuid())
  organizationId     String
  folio              String
  userId             String?
  asunto             String
  descripcion        String
  /// CRITICA | ALTA | MEDIA | BAJA (lib/soporte.ts)
  severidad          String    @default("MEDIA")
  /// Pantalla desde donde se pidio.
  pantalla           String?
  /// Datos tecnicos que la persona acepto adjuntar (JSON): navegador, pantalla, hora.
  datosTecnicos      String?
  /// RECIBIDA | EN_REVISION | ESPERANDO_CLIENTE | RESUELTA | CERRADA
  estado             String    @default("RECIBIDA")
  respuesta          String?
  primeraRespuestaAt DateTime?
  respondidaPorId    String?
  cerradaAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([organizationId, folio])
  @@index([organizationId])
  @@index([estado])
}

// -------------------------------------------------------------------- Soporte ---

/// Por que fallo, no que fallo. El codigo de falla describe el sintoma
/// ("desgaste mecanico"); la causa raiz describe el origen ("ruta de
/// lubricacion no ejecutada"). Separarlos es lo que permite atacar patrones
/// en vez de repetir reparaciones.
model RootCause {
  id             String   @id @default(cuid())
  organizationId String
  code           String
  description    String
  category       String?
  createdAt      DateTime @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workOrders   WorkOrder[]
  actividades  WorkOrderTask[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model FailureCode {
  id             String  @id @default(cuid())
  organizationId String
  code           String
  description    String
  category       String? // MECANICO | ELECTRICO | HIDRAULICO | OPERACION | OTRO

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workOrders     WorkOrder[]
  workOrderTasks WorkOrderTask[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model Notification {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  title          String
  body           String?
  link           String?
  kind           String   @default("INFO") // INFO | WARNING | CRITICAL | SUCCESS
  read           Boolean  @default(false)
  createdAt      DateTime @default(now())

  /// Bloque 5. Todo nulo o con valor por omision: los avisos anteriores se
  /// siguen leyendo igual, como avisos generales.
  ///
  /// El tipo de evento del catalogo (lib/avisos/catalogo.ts): OT_ASIGNADA,
  /// REFACCION_BAJO_MINIMO... GENERAL para los que no vienen del catalogo.
  tipo           String    @default("GENERAL")
  /// INFORMATIVA | BAJA | MEDIA | ALTA | CRITICA
  prioridad      String    @default("MEDIA")
  /// ORDENES | SOLICITUDES | PREVENTIVO | MEDIDORES | ALMACEN | COMPRAS | ADMINISTRACION
  modulo         String?
  /// El registro del que habla: WorkOrder, Part, PurchaseRequest...
  entidad        String?
  entidadId      String?
  /// Pide que alguien haga algo. Leerla no la atiende: se atiende cuando se
  /// resuelve lo que la origino.
  requiereAccion Boolean   @default(false)
  atendidaEl     DateTime?
  atendidaMotivo String?
  leidaEl        DateTime?
  /// Por que importa y que hay que hacer, en una linea cada uno.
  porQue         String?
  accion         String?
  /// Mismo problema, mismo destinatario: una sola notificacion que se
  /// actualiza, en vez de una nueva cada vez que corre el proceso.
  claveDedup     String?
  /// Cuantas veces se presento el mismo problema en esta notificacion.
  veces          Int       @default(1)
  actualizadaEl  DateTime?
  /// Identificador estable del evento: el mismo para todos sus destinatarios
  /// y canales. Es lo que se manda como identificador en los webhooks.
  eventoId       String?

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  entregas     EntregaAviso[]
  historial    HistorialAviso[]

  @@unique([userId, claveDedup])
  @@index([userId])
  @@index([organizationId, entidad, entidadId])
  @@index([userId, atendidaEl, createdAt])
}

/// Cada vez que un aviso cambia de pendiente a atendido, o vuelve a abrirse.
///
/// Un aviso se atiende cuando la condicion que lo origino deja de existir
/// (lib/avisos/condiciones.ts), no cuando alguien lo lee o toca el registro.
/// Aqui queda el porque: que condicion habia, cual hay ahora, que accion la
/// resolvio, quien la hizo y que proceso lo confirmo. La bitacora general no
/// lo repite: esto es historial tecnico del aviso.
model HistorialAviso {
  id                String   @id @default(cuid())
  organizationId    String
  notificationId    String
  /// El destinatario del aviso.
  userId            String
  tipo              String
  entidadId         String?
  /// ATENDIDA | REABIERTA
  cambio            String
  /// Lo que habia cuando se aviso y lo que hay ahora, en palabras.
  condicionAnterior String?
  condicionActual   String?
  /// La accion o evento que lo resolvio: «Cambio de estado IN_PROGRESS → COMPLETED».
  evento            String?
  /// Quien hizo la accion, cuando se sabe.
  actorId           String?
  /// FLUJO (lo resolvio una accion en el momento) | RECONCILIACION (lo
  /// confirmo el proceso programado) | PROGRAMADOR
  origen            String
  /// El motivo que ve la persona.
  motivo            String?
  createdAt         DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@index([organizationId, entidadId])
}

/// Cada intento de llevar un aviso por un canal: correo, navegador, webhook.
///
/// Es el historial tecnico, aparte de la bitacora: la bitacora dice quien
/// cambio que; esto dice si el aviso llego. Nunca guarda el contenido
/// completo ni secretos: titulo recortado, destino enmascarado, categoria del
/// error.
model EntregaAviso {
  id             String    @id @default(cuid())
  organizationId String
  notificationId String?
  /// Nulo en los avisos sin destinatario valido y en los webhooks.
  userId         String?
  webhookId      String?
  tipo           String
  eventoId       String
  /// CAMPANA | NAVEGADOR | CORREO | WEBHOOK
  canal          String
  /// PENDIENTE | EN_PROCESO | ENTREGADA | FALLIDA | EN_REINTENTO | CANCELADA |
  /// OMITIDA_PREFERENCIA | SIN_DESTINATARIO
  estado         String    @default("PENDIENTE")
  programadaPara DateTime  @default(now())
  intentadaEl    DateTime?
  intentos       Int       @default(0)
  proveedor      String?
  /// TEMPORAL | PERMANENTE | TIEMPO_AGOTADO | SIN_PROVEEDOR | DESTINO_INVALIDO |
  /// SIN_DISPOSITIVOS | USUARIO_INACTIVO | SIN_RESPONSABLE | LIMITE | ...
  errorCategoria String?
  /// Codigo o mensaje corto, sin datos del contenido.
  errorDetalle   String?
  proximoIntento DateTime?
  entregadaEl    DateTime?
  /// Lo que hace falta para reintentar un webhook: el evento en JSON, sin
  /// datos personales. En correo y navegador se arma de la notificacion.
  carga          String?
  /// Evita dos entregas del mismo evento por el mismo canal al mismo destino.
  claveDedup     String    @unique
  /// Titulo recortado, para leer el historial sin abrir cada aviso.
  resumen        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  notification Notification? @relation(fields: [notificationId], references: [id], onDelete: SetNull)
  webhook      Webhook?      @relation(fields: [webhookId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([estado, programadaPara])
}

/// Lo que cada persona quiere recibir. Una por usuario: el usuario pertenece
/// a una sola empresa, asi que no se comparte entre organizaciones.
model PreferenciaAvisos {
  id                 String   @id @default(cuid())
  organizationId     String
  userId             String   @unique
  /// Canales que la persona permite, en JSON: ["NAVEGADOR","CORREO"].
  canales            String   @default("[\"NAVEGADOR\",\"CORREO\"]")
  /// Tipos de aviso configurables que apago, en JSON.
  tiposApagados      String   @default("[]")
  resumenDiario      Boolean  @default(true)
  resumenSemanal     Boolean  @default(true)
  /// Horario para avisos no criticos, "HH:MM". Nulo: el de la empresa.
  horaInicio         String?
  horaFin            String?
  /// Sitios de interes en JSON; vacio = todos los que le tocan por rol.
  sitios             String   @default("[]")
  /// El navegador nego el permiso: no se le vuelve a pedir solo.
  navegadorRechazado Boolean  @default(false)
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

/// Como avisa la empresa. Sin renglon, rigen los valores recomendados.
model ConfigAvisos {
  id                   String   @id @default(cuid())
  organizationId       String   @unique
  /// Canales encendidos para la empresa, JSON: ["NAVEGADOR","CORREO","WEBHOOK"].
  canales              String   @default("[\"NAVEGADOR\",\"CORREO\",\"WEBHOOK\"]")
  /// Ventana para avisos no criticos, "HH:MM", en la zona de la empresa.
  horaInicio           String   @default("08:00")
  horaFin              String   @default("18:00")
  /// Horas antes del vencimiento para avisar que una OT esta por vencer.
  anticipacionHoras    Int      @default(24)
  /// Quienes reciben los avisos administrativos, JSON de ids. Vacio: dueno y
  /// administradores.
  destinatariosAdmin   String   @default("[]")
  resumenDiario        Boolean  @default(true)
  resumenSemanal       Boolean  @default(true)
  /// Hora local del resumen diario, "HH:MM". El semanal sale el lunes.
  horaResumen          String   @default("07:30")
  /// Mandar el resumen aunque no haya pendientes.
  resumenSinPendientes Boolean  @default(false)
  /// Reglas de escalamiento que la empresa ajusto, JSON. Lo que no esta, usa
  /// el valor recomendado.
  reglas               String   @default("{}")
  /// Nombre con que salen los correos.
  remitente            String?
  updatedAt            DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

/// Un recordatorio que sigue vivo mientras el problema siga ahi.
///
/// Una fila por regla y registro: el proceso programado la avanza (recordar,
/// subir de nivel) y la detiene cuando se atiende. Asi el mismo problema no
/// produce un aviso nuevo en cada corrida.
model Escalamiento {
  id              String    @id @default(cuid())
  organizationId  String
  regla           String
  entidad         String
  entidadId       String
  /// ACTIVO | AGOTADO (ya no insiste; sigue en resumenes) | DETENIDO
  estado          String    @default("ACTIVO")
  nivel           Int       @default(0)
  recordatorios   Int       @default(0)
  iniciadoEl      DateTime  @default(now())
  proximoEl       DateTime
  ultimoAvisoEl   DateTime?
  /// Quien debia actuar al iniciar: si cambia, el escalamiento se detiene.
  responsableId   String?
  detenidoEl      DateTime?
  motivoDetencion String?
  reconocidoPorId String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, regla, entidadId])
  @@index([estado, proximoEl])
}

/// Una credencial para que un sistema externo use la API de una empresa.
///
/// El secreto se muestra una sola vez, al crearla; aqui solo queda su huella.
/// La empresa sale de la credencial, nunca de un parametro de la peticion.
model CredencialApi {
  id             String    @id @default(cuid())
  organizationId String
  nombre         String
  /// Los primeros caracteres visibles, para reconocerla en la lista.
  prefijo        String    @unique
  huella         String    @unique
  /// JSON: ["activos:leer","solicitudes:crear","lecturas:crear",...]
  alcances       String    @default("[]")
  /// ACTIVA | REVOCADA
  estado         String    @default("ACTIVA")
  expiraEl       DateTime?
  ultimoUsoEl    DateTime?
  usos           Int       @default(0)
  creadaPorId    String?
  revocadaEl     DateTime?
  revocadaPorId  String?
  /// La credencial a la que sustituyo al rotar.
  rotadaDeId     String?
  createdAt      DateTime  @default(now())

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  usosApi      UsoApi[]
  idempotencia ClaveIdempotencia[]

  @@index([organizationId])
}

/// Registro de uso de la API: quien, que, cuando y con que resultado. Sin
/// cuerpo de la peticion.
model UsoApi {
  id             String   @id @default(cuid())
  /// Nulo cuando la credencial no existe: tambien se registra el intento.
  organizationId String?
  credencialId   String?
  metodo         String
  ruta           String
  estado         Int
  /// OK | RECHAZADA | LIMITE | ERROR
  resultado      String
  createdAt      DateTime @default(now())

  credencial CredencialApi? @relation(fields: [credencialId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([credencialId, createdAt])
}

/// Un destino al que la empresa quiere que MainTrack le avise por HTTP.
model Webhook {
  id                 String    @id @default(cuid())
  organizationId     String
  nombre             String
  url                String
  /// JSON de tipos de evento del catalogo.
  eventos            String    @default("[]")
  /// ACTIVO | PAUSADO | SUSPENDIDO
  estado             String    @default("ACTIVO")
  /// Secreto de firma cifrado con la llave de integraciones. Se muestra una
  /// vez; se guarda cifrado porque hace falta para firmar cada envio.
  secretoCifrado     String
  secretoPista       String
  ultimoEnvioEl      DateTime?
  ultimoResultado    String?
  fallasConsecutivas Int       @default(0)
  suspendidoEl       DateTime?
  creadoPorId        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entregas     EntregaAviso[]

  @@index([organizationId])
}

/// Una peticion externa ya procesada, para que repetirla no la duplique.
model ClaveIdempotencia {
  id             String   @id @default(cuid())
  organizationId String
  credencialId   String
  clave          String
  ruta           String
  estado         Int
  /// La respuesta que se dio, para devolver la misma al repetir.
  respuesta      String
  createdAt      DateTime @default(now())

  credencial CredencialApi @relation(fields: [credencialId], references: [id], onDelete: Cascade)

  @@unique([credencialId, clave])
  @@index([createdAt])
}

/// Contadores de uso por ventana de tiempo. La clave dice que se limita:
/// empresa, credencial, ruta, webhook o canal.
model LimiteUso {
  id        String   @id @default(cuid())
  clave     String
  ventana   DateTime
  conteo    Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([clave, ventana])
  @@index([ventana])
}

/// Un telefono o computadora que acepto recibir avisos de MainTrack.
///
/// Es POR DISPOSITIVO, no por persona: quien usa telefono y tableta tiene dos
/// renglones, y aceptar en uno no hace que llegue al otro. Esa es la naturaleza
/// del mecanismo del navegador y hay que explicarsela al usuario, porque de
/// otro modo lo vive como una falla.
model PushSubscription {
  id             String @id @default(cuid())
  organizationId String
  userId         String
  /// La direccion a la que el navegador entrega el aviso. La da el navegador,
  /// es unica en el mundo y es la identidad real de la suscripcion: si el
  /// usuario reinstala, cambia y hay que dar de alta una nueva.
  endpoint       String @unique
  /// Llaves de cifrado del navegador. El servidor cifra con ellas y ni Google
  /// ni Apple pueden leer el contenido del aviso al pasarlo.
  p256dh         String
  auth           String

  /// Como llamarle a este aparato en la lista: "iPhone", "Android · Chrome".
  /// Se calcula al darlo de alta; el usuario no tiene que nombrarlo.
  dispositivo String  @default("Dispositivo")
  /// El identificador crudo del navegador, para soporte. Cuando alguien dice
  /// "no me llegan", esto dice si instalo la aplicacion o quedo en el
  /// navegador, que es la causa mas comun en iPhone.
  userAgent   String?

  /// Ultimo aviso entregado. Sirve para distinguir una suscripcion viva de una
  /// que nunca ha recibido nada.
  ultimoEnvioAt DateTime?
  /// Fallos seguidos. El envio borra la suscripcion en cuanto el navegador
  /// dice que ya no existe; esto es para los errores pasajeros, que no deben
  /// dar de baja a nadie por un rato de mala red.
  fallos        Int       @default(0)
  createdAt     DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  entity         String
  entityId       String
  action         String
  summary        String?
  changes        String   @default("{}")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([entity, entityId])
  @@index([organizationId, createdAt])
}

/// Dias que no se trabajan.
///
/// Por organizacion y no una lista global: los festivos de ley son los mismos
/// para todos, pero cada empresa cierra en dias propios —el aniversario de la
/// planta, la semana de vacaciones— y el programador no debe proyectar
/// preventivos ahi.
model DiaFestivo {
  id             String   @id @default(cuid())
  organizationId String
  fecha          DateTime
  nombre         String
  /// De ley, o puesto por la empresa. Sirve para no borrar los de ley por error.
  deLey          Boolean  @default(false)
  createdById    String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("FestivoCreadoPor", fields: [createdById], references: [id])

  @@unique([organizationId, fecha])
  @@index([organizationId])
}

/// Refacciones que pueden usarse una por otra.
///
/// Dos casos distintos que la operacion vive todos los dias: la misma pieza de
/// otra marca —un balero 6205 de SKF o de NSK es el mismo balero— y el
/// sustituto que sirve cuando la original no llega a tiempo, casi siempre con
/// una salvedad que hay que decir en voz alta.
///
/// La relacion se guarda UNA vez y se lee en los dos sentidos: si A sirve para
/// B, B sirve para A. Guardar los dos renglones invita a que uno se actualice
/// y el otro no, y entonces el almacen contesta distinto segun por donde se
/// pregunte. El orden de los ids es canonico —el menor primero— para que la
/// llave unica impida registrar el mismo par dos veces al reves.
model EquivalenciaRefaccion {
  id             String   @id @default(cuid())
  organizationId String
  /// Siempre el id menor de los dos, para que el par no se pueda duplicar.
  partAId        String
  partBId        String
  /// EQUIVALENTE (la misma pieza, otra marca) | SUSTITUTO (sirve, con salvedad)
  tipo           String   @default("EQUIVALENTE")
  /// La salvedad, cuando la hay: "requiere espaciador de 2 mm", "solo para el
  /// lado libre". En un sustituto es lo mas importante del registro.
  nota           String?
  createdById    String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  partA        Part         @relation("EquivalenciaA", fields: [partAId], references: [id], onDelete: Cascade)
  partB        Part         @relation("EquivalenciaB", fields: [partBId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("EquivalenciaCreadaPor", fields: [createdById], references: [id])

  @@unique([partAId, partBId])
  @@index([organizationId])
  @@index([partBId])
}

/// Un plan aplicado a un activo.
///
/// El plan es la PLANTILLA —que se hace, cada cuanto, con que refacciones— y
/// esta tabla es donde ese plan se vuelve compromiso con un equipo concreto.
///
/// Aqui vive el calendario, y esa es la razon de existir de la tabla. Diez
/// compresores iguales comparten el mismo plan pero NO la misma fecha: uno se
/// instalo en marzo y otro en agosto, a uno se le hizo servicio la semana
/// pasada porque fallo. Si la proxima fecha viviera en el plan, los diez
/// generarian orden el mismo dia para siempre —peor que tener diez planes.
model PlanAsset {
  id             String @id @default(cuid())
  organizationId String
  planId         String
  assetId        String

  /// El medidor de ESTE equipo. Cada compresor lleva sus propias horas.
  meterId String?

  /// El calendario de este equipo con este plan.
  nextDueDate     DateTime?
  nextDueMeter    Float?
  lastGeneratedAt DateTime?
  lastCompletedAt DateTime?

  /// Cuantas veces se ha generado este plan para ESTE equipo.
  ///
  /// Es el contador que decide que actividades entran: toca la actividad
  /// cuando (ejecuciones + 1) es multiplo de su `cadaCuantas`. Vive en la
  /// asignacion y no en el plan porque diez compresores iguales van cada uno
  /// por su cuenta: uno se instalo en marzo y otro en agosto.
  ejecuciones Int @default(0)

  /// Se puede pausar un equipo sin desactivar el plan de los demas.
  active Boolean @default(true)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         MaintenancePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  asset        Asset           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  meter        Meter?          @relation(fields: [meterId], references: [id])
  createdBy    User?           @relation("AsignacionCreadaPor", fields: [createdById], references: [id])

  @@unique([planId, assetId])
  @@index([organizationId])
  @@index([assetId])
  @@index([nextDueDate])
}

/// El calendario de UNA actividad en UN equipo.
///
/// Es la pieza que faltaba. Hasta hoy el calendario vivia en la asignacion:
/// una sola fecha para todo el plan. Con eso no habia forma de expresar lo que
/// pasa todos los dias en una planta —que el aceite se cambio fuera de ciclo
/// porque la maquina ya estaba abierta, y solo ESE reloj debe moverse—, ni de
/// que un plan tuviera una actividad semanal y otra mensual sin que la
/// cadencia base se colapsara a un dia.
///
/// Un renglon por actividad y equipo: el mismo plan de compresores sirve a
/// seis compresores y cada uno trae su propia historia.
model PlanTaskAsset {
  id             String @id @default(cuid())
  organizationId String
  planTaskId     String
  assetId        String

  /// Lo que se declaro al asignar el plan, porque la primera vez no hay de
  /// donde derivarlo.
  ///
  /// Un plan recien creado no tiene historial: nadie puede saber cuando se
  /// hizo por ultima vez el cambio de aceite si el sistema no estaba. Alguien
  /// lo dice una sola vez y de ahi en adelante manda el historial.
  arranqueEl DateTime?

  /// Que significa `arranqueEl`.
  ///
  /// Verdadero: "la ultima vez se hizo ese dia", y el calendario cuenta hacia
  /// adelante desde ahi. Es el equipo que ya se venia manteniendo.
  ///
  /// Falso: "arranca ese dia", y esa fecha ES la primera vez que toca. Es el
  /// equipo nuevo, o la actividad que nunca se habia hecho.
  ///
  /// Sin esta distincion las dos capturas se verian iguales y una de las dos
  /// quedaria corrida un intervalo completo, en silencio.
  arranqueEsUltima Boolean @default(true)

  /// La ultima vez que se hizo de verdad, del historial.
  ///
  /// Se puede derivar de `WorkOrderTask` —que guarda `planTaskId` y
  /// `completedAt`—, pero se guarda aqui tambien porque el programador y la
  /// proyeccion la consultan en cada barrido y recorrer el historial de cada
  /// actividad de cada equipo cada vez no escala.
  ultimaEl DateTime?

  /// La fecha calculada. Se recalcula al cerrar, como hoy la de la asignacion.
  proximaEl DateTime?

  /// Se puede suspender una actividad en un equipo sin tocar el plan.
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planTask     PlanTask     @relation(fields: [planTaskId], references: [id], onDelete: Cascade)
  asset        Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([planTaskId, assetId])
  @@index([organizationId])
  @@index([assetId])
  @@index([proximaEl])
}

/// Un conjunto de equipos que sirve o no sirve como un todo.
///
/// En una planta es "la Linea 4, desde almacen de refacciones hasta producto
/// terminado". En un club es "la alberca": bombas, filtros, calentador y
/// clorador, repartidos en el cuarto de maquinas, el area de alberca y la
/// subestacion. Si falla el calentador, la alberca no abre. El objeto es el
/// mismo y la palabra cambia —de ahi terminoConjunto en Organization—.
///
/// Es distinto de Location a proposito: las ubicaciones son geografia y son
/// exclusivas —un equipo esta en un solo lugar—; los conjuntos son funcion y
/// se traslapan. La subestacion alimenta la linea, los elevadores y la
/// alberca al mismo tiempo.
model Conjunto {
  id             String  @id @default(cuid())
  organizationId String
  code           String
  name           String
  descripcion    String?

  /// Quien responde por que esto funcione. La mitad del valor del objeto es
  /// que haya un nombre; sin dueno vuelve a ser una etiqueta.
  responsableId String?

  /// MANUAL | IA. Un conjunto propuesto por la IA y aceptado sin revisar no
  /// vale lo mismo que uno armado a mano, y hay que poder distinguirlos
  /// despues sin adivinar.
  origen String @default("MANUAL")

  /// Bloque de mapas: a qué sitio (planta) pertenece la línea, para filtrar
  /// el mapa de una planta grande. Nulo: se toma el sitio de la mayoría de
  /// sus equipos, así las líneas que ya existían se filtran sin capturar nada.
  siteId        String?
  /// Clasificación libre para enfocarse dentro de un sitio: «Producción»,
  /// «Servicios auxiliares», «Utilidades»… Libre porque cada giro clasifica
  /// distinto; la pantalla sugiere las que ya se usan.
  clasificacion String?

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site         Site?           @relation(fields: [siteId], references: [id])
  responsable  User?           @relation("ConjuntoResponsable", fields: [responsableId], references: [id])
  equipos      ConjuntoAsset[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

/// Que equipo pertenece a que conjunto, y donde queda dibujado.
///
/// Las coordenadas viven AQUI y no en Asset. Un equipo puede estar en varios
/// conjuntos —la subestacion esta en tres—, asi que tiene una posicion
/// distinta en cada lienzo. Guardarlas en Asset haria que acomodar un lienzo
/// desacomodara los otros dos, en silencio y sin que nadie lo relacione.
///
/// Nulo en planoX/planoY significa SIN COLOCAR, igual que en Location.
model ConjuntoAsset {
  id             String @id @default(cuid())
  organizationId String
  conjuntoId     String
  assetId        String

  planoX     Int?
  planoY     Int?
  planoAncho Int  @default(3)
  planoAlto  Int  @default(2)

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conjunto     Conjunto     @relation(fields: [conjuntoId], references: [id], onDelete: Cascade)
  asset        Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([conjuntoId, assetId])
  @@index([organizationId])
  @@index([assetId])
}

/// Candado y ultima corrida de cada proceso programado.
///
/// Nacio de un hallazgo del Bloque 8: los cron no tenian candado, y dos
/// corridas solapadas del programador —el reintento de Cloud Scheduler, o el
/// boton manual mientras corre el cron— generaban DOS ordenes preventivas
/// identicas para el mismo plan y equipo. La decision se tomaba contra una
/// foto en memoria leida al inicio del barrido y se escribia mucho despues.
///
/// Sirve para dos cosas a la vez, y por eso vive en una sola tabla: tomar el
/// candado (`corriendoDesde` + `expiraEl`, con escritura condicional) y saber
/// cuando corrio por ultima vez, si termino bien y cuantas veces seguidas ha
/// fallado. Sin esto, un proceso que deja de correr es indistinguible de uno
/// que corre sin novedad: los dos callan.
///
/// No lleva relacion con Organization a proposito: es una tabla de la
/// plataforma, no de un inquilino, y una empresa borrada no debe llevarse el
/// historial de operacion por delante.
model ProcesoProgramado {
  /// "avisos", "diagnostico" o "scheduler:<organizationId>".
  clave          String  @id
  /// Presente solo en los procesos que corren por empresa.
  organizationId String?

  corriendoDesde DateTime?
  /// Hasta cuando vale el candado. Un proceso muerto no bloquea para siempre.
  expiraEl       DateTime?

  ultimoInicio   DateTime?
  ultimoFin      DateTime?
  ultimoOk       Boolean?
  ultimoResumen  String?
  ultimoError    String?
  fallasSeguidas Int       @default(0)
  corridas       Int       @default(0)

  @@index([ultimoFin])
  @@index([organizationId])
}

/// Lo caro del inicio, ya calculado.
///
/// El inicio de dirección y el de administración tardaban segundos con un año
/// de operación, y midiendo pieza por pieza resultó que el 98 % del costo eran
/// solo dos: los indicadores del periodo y la revisión de calidad de datos.
/// Las demás —vencidas, críticas, agotadas, compras por firmar— son conteos y
/// cuestan milisegundos.
///
/// Esas dos, además, son las que NO se mueven: son ventanas de 30 y 90 días.
/// Cerrar una orden mueve el cumplimiento menos de medio punto. Por eso se
/// calculan cada cuarto de hora y no en cada carga, y por eso lo dinámico
/// sigue consultándose en vivo: no hace falta congelarlo, ya es gratis.
///
/// Se guarda lo que el inicio DIBUJA —tres cifras y las reglas de captura
/// incumplidas—, no el resultado completo, que trae miles de renglones de
/// detalle que esa pantalla nunca muestra.
model ResumenInicio {
  organizationId String   @id
  calculadoEl    DateTime
  /// JSON: cumplimiento, disponibilidad, costo del periodo y reglas incumplidas.
  datos          String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// ------------------------------------------------------------------ Rondin ---

/// Un recorrido por la planta: el rondin del supervisor, con sus paradas.
///
/// Lo que hoy se pierde en el pasillo. Quien recorre ve cosas —un charco, una
/// guarda floja, un ruido— y eso se queda en su cabeza o en una libreta que
/// nadie vuelve a leer. Aqui queda con su foto, su lugar y su fecha.
///
/// El valor no esta en un recorrido: esta en el SIGUIENTE. Dos rondines del
/// mismo punto separados por un mes contestan la pregunta que nadie puede
/// contestar hoy: si aquella mancha crecio.
model Rondin {
  id             String    @id @default(cuid())
  organizationId String
  /// RD-000001. Por empresa, como todos los folios del sistema.
  numero         String
  siteId         String?
  /// El area que se declaro al empezar: «voy a recorrer la linea 2».
  ///
  /// No es adorno: es la segunda mejor forma de saber de que equipo se esta
  /// hablando cuando no hay codigo QR. Acota el universo de cuatrocientos
  /// equipos a doce, y con eso casi todo lo demas se resuelve solo.
  locationId     String?
  /// EN_CURSO | TERMINADO | CANCELADO. Sin enum nativo: el esquema es portable.
  estado         String    @default("EN_CURSO")
  iniciadoPorId  String?
  iniciadoEn     DateTime  @default(now())
  terminadoEn    DateTime?
  /// Lo que se dijo del recorrido completo, no de una parada.
  nota           String?
  /// Cuando se revisaron las fotos con IA. Nulo: todavia no se han revisado.
  ///
  /// Se guarda para no volver a pagar el analisis cada vez que alguien abre
  /// el recorrido, y para poder decir en pantalla si lo que se ve ya paso por
  /// ahi o no.
  analizadoEn    DateTime?
  createdAt      DateTime  @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site         Site?            @relation(fields: [siteId], references: [id])
  location     Location?        @relation(fields: [locationId], references: [id])
  iniciadoPor  User?            @relation(fields: [iniciadoPorId], references: [id])
  paradas      RondinParada[]
  hallazgos    RondinHallazgo[]

  @@unique([organizationId, numero])
  @@index([organizationId])
  @@index([organizationId, estado])
}

/// Cada parada del recorrido: un lugar, lo que se vio y lo que se dijo.
model RondinParada {
  id             String @id @default(cuid())
  organizationId String
  rondinId       String
  /// En que orden se hizo. La ruta del recorrido anterior ayuda a identificar
  /// las paradas del siguiente cuando no hay codigo.
  orden          Int    @default(0)

  reportPointId String?
  assetId       String?
  locationId    String?

  /// Como se supo de que equipo o punto se trata.
  ///
  /// QR | PLACA | DICHO | ELEGIDO | AREA | NINGUNO, de mas a menos confiable.
  /// Se guarda para poder MEDIR despues cuanto se depende de que alguien
  /// concilie a mano: si resulta que casi todo llega como ELEGIDO, es que
  /// faltan codigos pegados, y eso es una conversacion con el cliente, no un
  /// defecto del sistema.
  comoSeIdentifico String @default("NINGUNO")

  /// Lo que se dicto en la parada. De aqui sale casi todo el valor: la imagen
  /// dice como se ve, la voz dice que le preocupa a quien lo vio.
  observacion String?
  createdAt   DateTime @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rondin       Rondin           @relation(fields: [rondinId], references: [id], onDelete: Cascade)
  reportPoint  ReportPoint?     @relation(fields: [reportPointId], references: [id])
  asset        Asset?           @relation(fields: [assetId], references: [id])
  location     Location?        @relation(fields: [locationId], references: [id])
  adjuntos     Attachment[]
  hallazgos    RondinHallazgo[]

  @@index([organizationId])
  @@index([rondinId])
  @@index([organizationId, assetId])
}

/// Lo que la IA vio en las fotos de un rondin, para que una persona decida.
///
/// ── Por que se guardan como propuesta y no como trabajo ──
///
/// El modo de fallar de esto es afirmar una fuga donde hay una mancha vieja.
/// Si de ahi salieran ordenes solas, el sistema se llenaria de trabajo que no
/// existe, la gente dejaria de creerle, y entonces tampoco atenderia lo que si
/// es real. Por eso un hallazgo nace PROPUESTO y alguien lo acepta o lo
/// descarta; aceptarlo levanta una solicitud, que es el camino que ya existe
/// para lo que hay que atender.
///
/// ── Por que se guarda en que se baso ──
///
/// `baseVisual` es lo que el modelo dice que VE —«un charco oscuro bajo la
/// brida»— separado de lo que concluye. Quien revisa puede mirar la foto y
/// juzgar si eso esta ahi, que es la unica forma de que una persona pueda
/// contradecir a la maquina con fundamento en vez de por corazonada.
model RondinHallazgo {
  id             String  @id @default(cuid())
  organizationId String
  rondinId       String
  /// De que parada salio. Nulo si el modelo no pudo atribuirlo a ninguna.
  rondinParadaId String?
  /// El equipo, heredado de la parada. La IA NO lo decide.
  assetId        String?

  /// FUGA | SEGURIDAD | ORDEN | DETERIORO | OBSTRUCCION | OTRO
  categoria  String  @default("OTRO")
  titulo     String
  detalle    String?
  /// En que se basa, mirando la foto. Se separa de la conclusion a proposito.
  baseVisual String?
  /// SEGURO | PROBABLE | DUDOSO. Lo dudoso se enseña, pero se ve distinto.
  certeza    String  @default("DUDOSO")

  /// PROPUESTO | ACEPTADO | DESCARTADO
  estado        String    @default("PROPUESTO")
  /// La solicitud que se levanto al aceptarlo.
  workRequestId String?
  resueltoPorId String?
  resueltoEn    DateTime?
  createdAt     DateTime  @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rondin       Rondin        @relation(fields: [rondinId], references: [id], onDelete: Cascade)
  parada       RondinParada? @relation(fields: [rondinParadaId], references: [id], onDelete: SetNull)
  asset        Asset?        @relation(fields: [assetId], references: [id])
  workRequest  WorkRequest?  @relation(fields: [workRequestId], references: [id])
  resueltoPor  User?         @relation(fields: [resueltoPorId], references: [id])

  @@index([organizationId])
  @@index([rondinId])
  @@index([organizationId, estado])
}
